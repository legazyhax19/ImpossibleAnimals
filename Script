local function resetZone()
    table.clear(W.Units)
    table.clear(W.Dead)
    table.clear(W.Eggs)
    table.clear(W.Claimed)
    table.clear(W.candidates)
    W.runId, W.runIdGuess = nil, false
    W.seq, W.attackCount, W.clickTries, W.scanCount = 0, 0, 0, 0
    W.curTarget, W.curEgg, W.claimGoal = nil, nil, nil
end

local function markDead(id)
    if not W.Dead[id] then
        W.Dead[id] = true
        local u = W.Units[id]
        log(string.format("ฆ่า %s (%s) แล้ว", id, u and u.entry and u.entry.name or "?"))
    end
    W.Units[id] = nil
end

local function leaveZone(reason)
    if not W.InWild then return end
    W.InWild = false
    W.leftAt = os.clock()
    log(reason)
end

table.insert(W.conns, Changed.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end

    if data.reset then resetZone() end
    -- ข้อมูลเริ่มรอบ (reset/eggs) = เข้าโซนแล้ว · ข้อมูลสัตว์อย่างเดียวนับเฉพาะเมื่อออกมานานแล้ว (กันข้อมูลค้างหลังตาย)
    if not W.InWild and (data.reset or data.eggs or (data.units and os.clock() - W.leftAt > 10)) then
        W.InWild = true
        log("เข้าโซน Wild แล้ว")
    end
    if not W.runId and (W.scanCount or 0) < 10 then
        W.scanCount = (W.scanCount or 0) + 1
        scanUUIDs(data, "WildChanged")
    end

    if type(data.units) == "table" then
        for id, info in pairs(data.units) do
            if info == false then
                markDead(id)
            elseif type(info) == "table" then
                local u = W.Units[id] or {}
                for k, v in pairs(info) do u[k] = v end
                W.Units[id] = u
                if u.health and u.health <= 0 then markDead(id) end
            end
        end
    end
    if type(data.removed) == "table" then
        for _, id in pairs(data.removed) do markDead(id) end
    end

    if type(data.eggs) == "table" then
        for _, entry in pairs(data.eggs) do
            if type(entry) == "table" and entry.id then
                local e = W.Eggs[entry.id] or {}
                e.slot = entry.id
                e.tier = entry.tier or e.tier
                e.enemyId = entry.enemyId or e.enemyId
                e.position = entry.position or e.position
                if type(entry.egg) == "table" then
                    for k, v in pairs(entry.egg) do e[k] = v end
                end
                W.Eggs[entry.id] = e
            end
        end
    end

    if type(data.egg) == "table" and data.eggId then
        W.Claimed[data.eggId] = true
        log(string.format("เก็บแล้ว: %s  %s%s  %s ดาว", tostring(data.eggId), tostring(data.egg.kind),
            data.egg.shiny and (" " .. tostring(data.egg.shiny)) or "", tostring(data.egg.hatchStars)))
        Window:Notify({ Title = "เก็บไข่แล้ว", Content = string.format("%s  %s  %s ดาว",
            tostring(data.egg.kind), tostring(data.egg.shiny or ""), tostring(data.egg.hatchStars)),
            Color = Col.Green })
        if W.claimReturning then
            W.claimReturning = false
            leaveZone("เก็บไข่แล้ว ออกจากโซน")
        end
    end
end))

-- ตาย
local function watchCharacter(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    table.insert(W.conns, hum.Died:Connect(function()
        if W.InWild then
            if CFG.LEARN_LIMIT and W.curTarget then
                local n = enemyNum(W.curTarget)
                local old = getgenv().WildAutoFailNum
                if not old or n < old then
                    getgenv().WildAutoFailNum = n
                    log("จำไว้: สู้ " .. W.curTarget .. " ไม่ไหว")
                end
            end
            leaveZone("ตัวละครตาย ออกจากโซน")
        end
    end))
end
if player.Character then task.spawn(watchCharacter, player.Character) end
table.insert(W.conns, player.CharacterAdded:Connect(function(char)
    leaveZone("ตัวละครเกิดใหม่ ออกจากโซน")
    task.spawn(watchCharacter, char)
end))

-- หลุดโซน (ถูกย้ายไกลทันที) + เช็กว่าเดินติด
task.spawn(function()
    local lastPos
    local stillSince
    while W.running do
        local root = getRoot()
        if root then
            local pos = root.Position
            if lastPos and W.InWild and (pos - lastPos).Magnitude > 300
                and os.clock() - W.lastTeleport > 1 then
                leaveZone("ถูกย้ายออกจากโซน")
            end
            lastPos = pos
            if root.AssemblyLinearVelocity.Magnitude < 1.5 then
                stillSince = stillSince or os.clock()
            else
                stillSince = nil
            end
            W.stuck = stillSince ~= nil and os.clock() - stillSince > 0.6
        end
        task.wait(0.2)
    end
end)

