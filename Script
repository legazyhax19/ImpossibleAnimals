-- เก็บไข่
local function pickClaimable()
    local drops = droppedEggs()
    if #drops == 0 then return nil end
    if CFG.CLAIM_MODE == "Target" then
        local te = targetEgg()
        for _, d in ipairs(drops) do
            if te and d.egg.slot == te.slot then return d end
        end
        return nil
    end
    table.sort(drops, function(a, b)
        local sa, sb = a.egg.hatchStars or 0, b.egg.hatchStars or 0
        if sa ~= sb then return sa > sb end
        return (a.egg.shiny and 1 or 0) > (b.egg.shiny and 1 or 0)
    end)
    if CFG.CLAIM_MODE == "Best" then
        -- เก็บเฉพาะเมื่อใบที่ดรอปดีที่สุดในบรรดาไข่ที่เหลือทั้งหมด
        local te = targetEgg()
        if te and (drops[1].egg.hatchStars or 0) < (te.hatchStars or 0) then return nil end
    end
    return drops[1]
end

task.spawn(function()
    while W.running do
        if CFG.AUTO_CLAIM and W.InWild then
            local d = pickClaimable()
            if d then
                local pos = d.model:GetPivot().Position
                W.claimGoal = pos
                if distTo(pos) <= 6 or not CFG.AUTO_MOVE then
                    log("เก็บไข่ " .. d.egg.slot .. " ...")
                    claimEgg(d.egg.slot)
                    for _ = 1, 20 do
                        if W.Claimed[d.egg.slot] then break end
                        task.wait(0.25)
                    end
                    W.claimGoal = nil
                end
            else
                W.claimGoal = nil
            end
        else
            W.claimGoal = nil
        end
        task.wait(0.3)
    end
end)

