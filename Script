local KIND_COLOR = {
    common = "#9d9d9d", rare = "#3b8eea", epic = "#d670d6",
    legendary = "#e5c07b", mythic = "#f14c4c",
}
local SHINY_COLOR = { golden = "#e5c07b", diamond = "#29b8db" }

local eggRows = {}
local function eggRow(i)
    if eggRows[i] then return eggRows[i] end
    local b = new("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.hover,
        BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = i }, eggList_)
    local lbl = new("TextLabel", { Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1, Font = MONO, TextSize = 12, RichText = true, TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left, Text = "" }, b)
    b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.4 end)
    b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
    eggRows[i] = { btn = b, lbl = lbl, slot = nil }
    b.MouseButton1Click:Connect(function()
        local slot = eggRows[i].slot
        if slot == "__auto" then
            CFG.TARGET_EGG = nil
            log("เป้าหมายไข่: เลือกดีสุดอัตโนมัติ")
        elseif slot then
            CFG.TARGET_EGG = (CFG.TARGET_EGG == slot) and nil or slot
            log("เป้าหมายไข่: " .. tostring(CFG.TARGET_EGG or "อัตโนมัติ") .. " (มีผลรอบถัดไป)")
        end
    end)
    return eggRows[i]
end

local function pad(s, n)
    s = tostring(s)
    return #s >= n and s or (s .. string.rep(" ", n - #s))
end

local function renderEggs()
    local list = eggList()
    local failNum = getgenv().WildAutoFailNum
    local i = 1
    local auto = eggRow(i)
    auto.slot = "__auto"
    auto.lbl.Text = (CFG.TARGET_EGG == nil and '<font color="#0078d4">●</font> ' or '<font color="#5f5f5f">○</font> ')
        .. '<font color="#e6e6e6">Auto</font>  <font color="#969696">เลือกไข่ดาวมากสุดเอง</font>'
    auto.btn.Visible = true
    if #list == 0 then
        i += 1
        local r = eggRow(i)
        r.slot = nil
        r.lbl.Text = '<font color="#5f5f5f">ยังไม่มีข้อมูลไข่ — เข้าโซน Wild ก่อน</font>'
        r.btn.Visible = true
    end
    for _, e in ipairs(list) do
        i += 1
        local r = eggRow(i)
        r.slot = e.slot
        r.btn.Visible = true
        local picked = CFG.TARGET_EGG == e.slot
        local current = W.curEgg and W.curEgg.slot == e.slot
        local kc = KIND_COLOR[tostring(e.kind)] or "#cccccc"
        local sc = e.shiny and (SHINY_COLOR[tostring(e.shiny)] or "#e5c07b") or "#5f5f5f"
        local tag = ""
        if current then tag = '<font color="#23d18b">กำลังไปเอา</font>'
        elseif W.Dead[e.enemyId] then tag = '<font color="#5f5f5f">สัตว์ตายแล้ว</font>'
        elseif failNum and enemyNum(e.enemyId) >= failNum then tag = '<font color="#f14c4c">ยากเกิน</font>' end
        r.lbl.Text = string.format(
            '%s <font color="#e6e6e6">%s</font> <font color="#969696">T%s</font> <font color="%s">%s</font> <font color="%s">%s</font> <font color="#e5c07b">%s*</font> <font color="#29b8db">%s</font> %s',
            picked and '<font color="#0078d4">●</font>' or '<font color="#5f5f5f">○</font>',
            esc(pad(e.slot, 6)), esc(pad(e.tier, 3)), kc, esc(pad(e.kind, 10)),
            sc, esc(pad(e.shiny or "-", 8)), esc(pad(e.hatchStars, 3)), esc(pad(e.enemyId, 5)), tag)
    end
    for j = i + 1, #eggRows do
        eggRows[j].btn.Visible = false
        eggRows[j].slot = nil
    end
end

