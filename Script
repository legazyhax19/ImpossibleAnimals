local UUID_PAT = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

local function setRunId(id, where)
    if W.runId ~= id then
        W.runId, W.runIdGuess = id, false
        -- (ไม่ต้อง log)
    end
end

local function addCandidate(id, where)
    if W.runId or W.creatureIds[id] then return end
    for _, c in ipairs(W.candidates) do if c.id == id then return end end
    table.insert(W.candidates, { id = id, where = where })
end

local function scanUUIDs(v, path, depth)
    depth = depth or 0
    if depth > 4 then return end
    if type(v) == "string" then
        if v:match(UUID_PAT) then addCandidate(v, path) end
    elseif type(v) == "table" then
        for k, val in pairs(v) do
            if not (depth == 0 and (k == "units" or k == "eggs" or k == "chests")) then
                if type(k) == "string" and k:match(UUID_PAT) then addCandidate(k, path) end
                scanUUIDs(val, path .. "." .. tostring(k), depth + 1)
            end
        end
    end
end

-- ดักการกดของเกมเอง → จับ id รอบ + sequence (hook ติดตั้งครั้งเดียว ใช้ร่วมกับสคริปต์รุ่นก่อนได้)
getgenv().WildAutoOnCall = function(a1, a2)
    local A = getgenv().WildAuto
    if not A or type(a2) ~= "table" then return end
    if type(a2.id) == "string" and a2.id:match(UUID_PAT) and (a1 == "Attack" or a1 == "ClaimEgg") then
        setRunId(a2.id, "จากการกดของเกม")
    end
    if a1 == "Attack" and type(a2.sequence) == "number" then
        A.seq = math.max(A.seq, a2.sequence)
    end
end
-- เข้า Wild เองด้วยมือ (กด Ready ในเกม) ก็นับด้วย
local prevOnCall = getgenv().WildAutoOnCall
getgenv().WildAutoOnCall = function(a1, a2)
    local A = getgenv().WildAuto
    if A and a1 == "Ready" then A.readySent = true end
    return prevOnCall(a1, a2)
end

