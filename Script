local rowCount = 0
local function row(parent, title, desc)
    rowCount += 1
    local r = new("Frame", { Size = UDim2.new(1, 0, 0, desc and 52 or 40), BackgroundTransparency = 1,
        LayoutOrder = rowCount }, parent)
    local n = (parent:GetAttribute("rows") or 0) + 1
