-- อ่านการ์ดตัวละคร แล้วเลือกตาม PICK_MODE
local SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, QA = 1e15, QI = 1e18, SX = 1e21, SP = 1e24, OC = 1e27, NO = 1e30, DC = 1e33 }
local function parseNumber(text)
    text = tostring(text or ""):gsub(",", "")
    local n, suf = text:match("(%d[%d%.]*)%s*(%a*)")
    n = tonumber(n)
    if not n then return 0 end
    suf = (suf or ""):upper()
    if suf ~= "" and not SUFFIX[suf] then
        suf = suf:sub(1, 2)
        if not SUFFIX[suf] then suf = suf:sub(1, 1) end
    end
    return n * (SUFFIX[suf] or 1)
end

local function cardText(card, path)
    local o = card
    for part in path:gmatch("[^%.]+") do o = o and o:FindFirstChild(part) end
    return o and o.Text or ""
end

function pickCard(creatures)
    local best, bestInfo
    for _, card in ipairs(creatures:GetChildren()) do
        if card.Name:match("^Creature%d+$") and card:GetAttribute("CreatureId") then
            local lv = cardText(card, "Content.Title.Level")
            local info = {
                name = cardText(card, "Content.Title.CreatureName"),
                levelText = lv, level = parseNumber(lv),
                stars = parseNumber(cardText(card, "Content.Stats.Content.Stars")),
            }
            local better = false
            if not best then
                better = true
            elseif CFG.PICK_MODE == "Most stars" then
                better = info.stars > bestInfo.stars or (info.stars == bestInfo.stars and info.level > bestInfo.level)
            else
                better = info.level > bestInfo.level or (info.level == bestInfo.level and info.stars > bestInfo.stars)
            end
            if better then best, bestInfo = card, info end
        end
    end
    return best, bestInfo
end

local function enterWild()
    if W.entering then return false end
    W.entering = true
    local function done(v) W.entering = false return v end

    resetZone()
    local ok, res = pcall(function() return Request:InvokeServer("Create", { teleport = true }) end)
    if not ok then log("Create error:", res) return done(false) end
    scanUUIDs(res, "Create")

    local creatures
    pcall(function()
        creatures = player:WaitForChild("PlayerGui"):WaitForChild("ImpossibleAnimals", 10):WaitForChild("Root", 10)
            :WaitForChild("WildPicker", 10):WaitForChild("Popup", 10):WaitForChild("Creatures", 10)
    end)
    if not creatures then log("ไม่เจอหน้าเลือกตัวละคร") return done(false) end

    -- รอการ์ดโหลด
    for _ = 1, 40 do
        local c1 = creatures:FindFirstChild("Creature1")
        if c1 and c1:GetAttribute("CreatureId") then break end
        task.wait(0.25)
    end
    task.wait(0.5)
    local card, info = pickCard(creatures)
    if not card then
        log("ไม่เจอการ์ดตัวละคร")
        return done(false)
    end
    for _, c in ipairs(creatures:GetChildren()) do
        local cid = c:GetAttribute("CreatureId")
        if cid then W.creatureIds[cid] = true end
    end
    log(string.format("เข้า Wild ด้วย %s (%s)", info.name, info.levelText))

    local ok2, res2 = pcall(function()
        return Request:InvokeServer("Ready", { card:GetAttribute("CreatureId") })
    end)
    if not ok2 then log("Ready error:", res2) return done(false) end
    scanUUIDs(res2, "Ready")
    W.readySent = true

    -- รอหน้าเลือกตัวปิด แล้วนับว่าเข้าโซน
    for _ = 1, 40 do
        if not pickerOpen() then break end
        task.wait(0.25)
    end
    task.wait(0.5)
    if not pickerOpen() then W.InWild = true end
    return done(W.InWild)
end

-- หา id รอบ: ลองค่าที่เจอในข้อมูลก่อน → ไม่มีก็คลิกจอให้เกมตีเอง
local function ensureRunId(target)
    if W.runId then return true end
    local c = table.remove(W.candidates, 1)
    if c then
        W.runId, W.runIdGuess, W.guessHp, W.guessAttacks = c.id, true, nil, 0
        return true
    end
    if CFG.AUTO_GET_ID ~= false then
        W.clickTries = (W.clickTries or 0) + 1
        if W.clickTries <= 10 then
            autoClick()
            for _ = 1, 10 do
                if W.runId then return true end
                task.wait(0.1)
            end
            return false
        end
    end
    if os.clock() - (W.lastAskLog or 0) > 5 then
        W.lastAskLog = os.clock()
        log("ยังไม่รู้ id ของรอบ — กดตีเองหนึ่งครั้ง (ตีลมก็ได้)")
    end
    return false
end

