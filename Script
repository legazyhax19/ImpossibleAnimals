    local egg = W.curEgg
    local u = W.curTarget and W.Units[W.curTarget]
    status:SetInfo(string.format(
        'egg    <font color="#e6e6e6">%s</font>\nenemy  <font color="#e6e6e6">%s</font>\nenter %s  move %s  attack %s  claim %s   id %s  atk %d\n<font color="#5f5f5f">%s</font>',
        esc(egg and string.format("%s  %s%s  %s*  (%s)", egg.slot, tostring(egg.kind),
            egg.shiny and (" " .. tostring(egg.shiny)) or "", tostring(egg.hatchStars), tostring(egg.enemyId)) or "-"),
        esc(W.curTarget and string.format("%s  %s  HP %s", W.curTarget, u and u.entry and u.entry.name or "?",
            u and tostring(math.floor(u.health or 0)) or "?") or "-"),
        onOff(CFG.AUTO_ENTER), onOff(CFG.AUTO_MOVE), onOff(CFG.AUTO_ATTACK), onOff(CFG.AUTO_CLAIM),
        W.runId and '<font color="#23d18b">ok</font>' or '<font color="#5f5f5f">--</font>',
        W.attackCount or 0, esc(lastLog:sub(1, 70))))
end

task.spawn(function()
    local tick = 0
    while Window:IsAlive() and W.running do
        pcall(updateStatus)
        tick += 1
        if tick % 2 == 0 then
            if Window.Current == pEggs then pcall(renderEggs)
            elseif Window.Current == pUnits then pcall(renderUnits) end
        end
        task.wait(0.5)
    end
end)

