-- STEP 2+: เล่นหนึ่งรอบ → คืนค่า "claimed" / "died" / "fail" / "stopped"
---------------------------------------------------------------------
local function runOnce(isRestart)
    local startTime = os.clock()
    resetRound()

    if CFG.AUTO_START or isRestart then
        local started = false
        for try = 1, 5 do
            if not W.active then return "stopped" end
            if autoStart() then started = true break end
            log("เริ่มรอบไม่สำเร็จ ลองใหม่ใน 3 วิ (" .. try .. "/5)")
            task.wait(3)
        end
        if not started then return "fail" end
    end

    -- รอข้อมูลโซน
    log("รอข้อมูลโซน...")
    local t = 0
    while W.active and (not W.InWild or next(W.Eggs) == nil) and t < 20 do
        task.wait(0.5)
        t += 0.5
    end
    if not next(W.Eggs) then
        log("ไม่ได้รับรายการไข่ (ยังไม่ได้เข้าโซน?)")
        return "fail"
    end
    task.wait(1) -- เผื่อข้อมูลสัตว์มาไม่ครบ

    local list = eggList()
    printEggs(list)
    local egg = chooseEgg(list)
    if not egg then
        log("ไม่มีไข่ที่ตรงเงื่อนไข")
        return "noegg"
    end
    W.curEgg = egg
    log(string.format("เป้าหมาย: %s  %s%s  ดาว %s  (ต้องฆ่า %s, tier %s)",
        egg.slot, tostring(egg.kind), egg.shiny and (" " .. tostring(egg.shiny)) or "",
        tostring(egg.hatchStars), tostring(egg.enemyId), tostring(egg.tier)))

    local current
    local deadAt
    W.fighting = true
    W.lastPos = nil

    while W.active do
        if os.clock() - startTime > CFG.MAX_RUNTIME then
            log("รอบนี้นานเกิน MAX_RUNTIME — ถือว่าค้าง")
            W.fighting = false
            return "died"
        end
        if W.claimed then
            W.fighting = false
            task.wait(2)
            return "claimed"
        end

        if not W.claiming then checkLeft() end
        if (W.died or W.left) and not W.claiming then
            W.fighting = false
            log(W.died and "ตัวละครตาย!" or "หลุดออกจากโซน!")
            if current and CFG.LEARN_LIMIT and not W.claimed then
                local n = enemyNum(current)
                local old = getgenv().WildAutoFailNum
                if not old or n < old then
                    getgenv().WildAutoFailNum = n
                    log("จำไว้: สู้ " .. current .. " ไม่ไหว รอบหน้าจะเลือกไข่ที่ต่ำกว่า e" .. n)
                end
            end
            return "died"
        end

        local root = getRoot()
        if not root then
            task.wait(0.5)
        elseif isAlive(egg.enemyId) or (CFG.KILL_IN_ORDER and nextEnemy(egg.enemyId)) then
            -- ยังต้องตีอยู่
            if not CFG.AUTO_ATTACK then
                task.wait(0.5)
            else
                local target = nextEnemy(egg.enemyId)
                if target then
                    if target ~= current then
                        current = target
                        W.curTarget = target
                        local u = W.Units[target]
                        log(string.format("ไปตี %s (%s Lv.%s HP %s)", target,
                            u.entry and u.entry.name or "?",
                            tostring(u.entry and u.entry.level or "?"),
                            tostring(math.floor(u.health or 0))))
                    end
                    local u = W.Units[target]
                    if u and u.position then
                        local close = approach(u.position, CFG.ATTACK_RANGE)
                        local d = distTo(u.position)

                        -- เช็กว่าเดินต่อไม่ได้ (ความเร็วแทบเป็น 0)
                        local r = getRoot()
                        local still = r and r.AssemblyLinearVelocity.Magnitude < 1.5
                        if still then
                            W.stillSince = W.stillSince or os.clock()
                        else
                            W.stillSince = nil
                        end
                        local stuck = W.stillSince and (os.clock() - W.stillSince) > 0.6

                        if (close or (stuck and d <= CFG.STUCK_RANGE)) and not W.runId then
                            -- ยังไม่รู้ id รอบ → ลองเดาจาก candidates ก่อน
                            local c = table.remove(W.candidates, 1)
                            if c then
                                W.runId = c.id
                                W.runIdGuess = true
                                W.guessHp = nil
                                W.guessAttacks = 0
                                log("ลองใช้ id " .. c.id .. " (จาก " .. c.where .. ")")
                            else
                                -- ไม่รู้ id → คลิกหน้าจอเองให้เกมตี แล้วจับ id จากการตีนั้น
                                W.clickTries = (W.clickTries or 0) + 1
                                if W.clickTries <= 10 then
                                    if W.clickTries == 1 then
                                        log("ยังไม่รู้ id ของรอบ — คลิกหน้าจอเองเพื่อให้เกมตี...")
                                    end
                                    if not autoClick() then
                                        W.clickTries = 99
                                        log("executor คลิกเองไม่ได้")
                                    end
                                    -- รอให้ hook จับ id
                                    for _ = 1, 10 do
                                        if W.runId then break end
                                        task.wait(0.1)
                                    end
                                elseif os.clock() - (W.lastAskLog or 0) > 4 then
                                    W.lastAskLog = os.clock()
                                    log(">>> คลิกเองแล้วยังไม่ได้ id — กดตีเองหนึ่งครั้ง (ตีลมก็ได้) <<<")
                                    task.wait(0.3)
                                else
                                    task.wait(0.3)
                                end
                            end
                        elseif close or (stuck and d <= CFG.STUCK_RANGE) then
                            attack(target, u.position)
                            -- ถ้า id เป็นแค่การเดา: ตี 8 ครั้งแล้ว HP ไม่ลด = id ผิด
                            if W.runIdGuess then
                                local hp = u.health or 0
                                W.guessHp = W.guessHp or hp
                                W.guessAttacks += 1
                                if hp < W.guessHp or not isAlive(target) then
                                    W.runIdGuess = false
                                    log("id ถูกต้อง ตีเข้าแล้ว")
                                elseif W.guessAttacks >= 8 then
                                    log("id " .. W.runId .. " ตีไม่เข้า ลองตัวถัดไป")
                                    W.runId = nil
                                end
                            end
                            task.wait(CFG.ATTACK_DELAY)
                        else
                            if CFG.DEBUG_ATTACK and os.clock() - (W.lastDistLog or 0) > 2 then
                                W.lastDistLog = os.clock()
                                log(string.format("กำลังเดินไป %s  ระยะ %.0f%s", target, d,
                                    stuck and "  (ติด เดินต่อไม่ได้)" or ""))
                            end
                            task.wait(0.2)
                        end
                    else
                        task.wait(0.2)
                    end
                else
                    task.wait(0.3)
                end
            end
        else
            -- สัตว์เป้าหมายตายแล้ว → ไปเก็บไข่
            if not CFG.AUTO_CLAIM then
                log("สัตว์เป้าหมายตายแล้ว — AUTO_CLAIM ปิดอยู่ ไปเก็บเองได้เลย")
                W.fighting = false
                return "stopped"
            end
            deadAt = deadAt or os.clock()
            local model = findDroppedEgg(egg.enemyId)
            local pos = model and model:GetPivot().Position or egg.position
            if not model and os.clock() - deadAt < 5 then
                task.wait(0.3) -- รอไข่ดรอป
            elseif approach(pos, 5) then
                W.claiming = true -- เก็บไข่แล้วเกมจะส่งกลับฐาน ไม่ใช่การหลุด
                claimEgg(egg.slot)
                -- รอผลยืนยัน
                for _ = 1, 20 do
                    if W.claimed then break end
                    task.wait(0.25)
                end
                if not W.claimed then
                    log("ยังไม่ได้รับยืนยันการเก็บ ลองใหม่...")
                    task.wait(1)
                end
            else
                task.wait(0.2)
            end
        end
    end

    W.fighting = false
    return "stopped"
end

---------------------------------------------------------------------
-- ลูปนอก: ตาย/หลุด → รอแล้วเริ่มใหม่
---------------------------------------------------------------------
function W.Start()
    if W.active then
        log("กำลังทำงานอยู่แล้ว")
        return
    end
    W.active = true
    W.restarts = 0
    log("เริ่มทำงาน")
    task.spawn(function()
    local restarts = 0
    local result = runOnce(false)

    while W.active and CFG.AUTO_RESTART and (result == "died" or result == "fail")
        and restarts < CFG.MAX_RESTARTS do
        restarts += 1
        W.restarts = restarts
        log(string.format("เริ่มรอบใหม่ใน 5 วิ... (ครั้งที่ %d/%d)", restarts, CFG.MAX_RESTARTS))
        task.wait(5)
        -- รอให้ตัวละครเกิดใหม่
        for _ = 1, 20 do
            if getRoot() then break end
            task.wait(0.5)
        end
        task.wait(2)
        if not W.active then break end
        result = runOnce(true)
    end

    if result == "claimed" then
        log("เสร็จ! เก็บไข่แล้ว")
    elseif result == "noegg" then
        log("ไม่มีไข่ที่สู้ไหว — ลองเปลี่ยนตัวละครที่แข็งกว่า หรือล้างค่าที่จำไว้ด้วย getgenv().WildAutoFailNum = nil")
    elseif restarts >= CFG.MAX_RESTARTS then
        log("เริ่มใหม่ครบ " .. CFG.MAX_RESTARTS .. " ครั้งแล้ว หยุด")
    end
    W.active = false
    W.fighting = false
    W.curTarget = nil
    log("จบการทำงาน")
    end)
end


