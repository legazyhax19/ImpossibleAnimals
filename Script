local function attack(targetId, targetPos)
    local root = getRoot()
    if not root or not W.runId then return false end
    local dir = flat(targetPos) - flat(root.Position)
    dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 0, -1)
    W.seq += 1
    local ok, res = pcall(function()
        return Request:InvokeServer("Attack", {
            id = W.runId,
            direction = dir,
            sequence = W.seq,
            targetId = targetId,
        })
    end)
    W.attackCount = (W.attackCount or 0) + 1
    if not ok then
        log("Attack error:", res)
    elseif CFG.DEBUG_ATTACK and (W.attackCount <= 5 or W.attackCount % 20 == 0) then
        local u = W.Units[targetId]
        local resText = tostring(res)
        if type(res) == "table" then
            local parts = {}
            for k, v in pairs(res) do table.insert(parts, tostring(k) .. "=" .. tostring(v)) end
            resText = "{" .. table.concat(parts, ", ") .. "}"
        end
        log(string.format("ตีครั้งที่ %d → %s  seq=%d  ระยะ %.0f  HP สัตว์ %s  ผล=%s",
            W.attackCount, targetId, W.seq, distTo(targetPos),
            tostring(u and math.floor(u.health or 0) or "?"), resText))
    end
    return ok, res
end

-- เข้าใกล้ตำแหน่ง (เรียกซ้ำในลูปได้) คืนค่า true ถ้าถึงระยะแล้ว
local function approach(pos, range)
    local root, hum = getRoot()
    if not root or typeof(pos) ~= "Vector3" then return false end
    if distTo(pos) <= range then return true end

    if CFG.TELEPORT then
        local from = flat(root.Position)
        local to = flat(pos)
        local back = (from - to)
        back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)
        local stand = to + back * math.max(range - 3, 2)
        local y = root.Position.Y
        root.CFrame = CFrame.new(Vector3.new(stand.X, y, stand.Z), Vector3.new(to.X, y, to.Z))
        task.wait(0.1)
    elseif hum then
        hum:MoveTo(Vector3.new(pos.X, root.Position.Y, pos.Z))
    end
    return distTo(pos) <= range
end

local function claimEgg(slot)
    local ok, res = pcall(function()
        return Request:InvokeServer("ClaimEgg", {
            id = W.runId or guid(),
            returning = CFG.RETURN_AFTER,
