if getgenv().WildAuto then
    pcall(getgenv().WildAuto.Stop)
end

local W = {
    Units = {}, Dead = {}, Eggs = {},
    conns = {}, running = true, InWild = false,
    seq = 0,
    runId = nil,        -- id ของรอบ (เกมใช้ค่าเดียวกันทุกครั้งที่ตีในรอบนั้น)
    candidates = {},    -- id ที่อาจจะใช่ (หาจากข้อมูลที่เกมส่งมา)
    creatureIds = {},   -- UUID ของตัวละคร (ไม่ใช่ id รอบ)
}
getgenv().WildAuto = W

local function log(...)
    print("[Auto]", ...)
end

function W.Stop()
    if not W.running then return end
    W.running = false
    for _, c in ipairs(W.conns) do c:Disconnect() end
    if getgenv().WildAuto == W then getgenv().WildAuto = nil end
    log("หยุดแล้ว")
end

---------------------------------------------------------------------
-- ตัวช่วย
---------------------------------------------------------------------
local function guid()
    return HttpService:GenerateGUID(false):lower()
end

local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
end

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

local function distTo(pos)
    local root = getRoot()
    if not root or typeof(pos) ~= "Vector3" then return math.huge end
    return (flat(pos) - flat(root.Position)).Magnitude
end

local function enemyNum(id)
    return tonumber(tostring(id):match("%d+")) or 0
end

local function isAlive(id)
    if W.Dead[id] then return false end
    local u = W.Units[id]
    return u ~= nil and (u.health == nil or u.health > 0)
end

---------------------------------------------------------------------
-- หา id ของรอบ
---------------------------------------------------------------------
local UUID_PAT = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

local function addCandidate(id, where)
    if W.runId or W.creatureIds[id] then return end
    for _, c in ipairs(W.candidates) do
        if c.id == id then return end
    end
    table.insert(W.candidates, { id = id, where = where })
    print("[Auto] เจอ id ที่อาจเป็นของรอบ: " .. id .. "  (จาก " .. where .. ")")
end

local function scanUUIDs(v, path, depth)
    depth = depth or 0
    if depth > 4 then return end
    if type(v) == "string" then
        if v:match(UUID_PAT) then addCandidate(v, path) end
    elseif type(v) == "table" then
        for k, val in pairs(v) do
            -- ข้ามข้อมูลสัตว์/ไข่/หีบ (ยาวและไม่น่ามี)
            if not (depth == 0 and (k == "units" or k == "eggs" or k == "chests")) then
                if type(k) == "string" and k:match(UUID_PAT) then addCandidate(k, path .. "[key]") end
                scanUUIDs(val, path .. "." .. tostring(k), depth + 1)
            end
        end
    end
end

local function setRunId(id, where)
    if W.runId ~= id then
        W.runId = id
        W.runIdGuess = false
        print("[Auto] ได้ id ของรอบแล้ว: " .. id .. "  (จาก " .. where .. ")")
    end
end

---------------------------------------------------------------------
-- รับข้อมูลจากเกม
---------------------------------------------------------------------
local function markDead(id)
    if not W.Dead[id] then
        W.Dead[id] = true
        local u = W.Units[id]
        log(string.format("ฆ่า %s (%s) แล้ว", id, u and u.entry and u.entry.name or "?"))
    end
    W.Units[id] = nil
end

table.insert(W.conns, Changed.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end
    W.InWild = true
    if not W.runId and (W.scanCount or 0) < 10 then
        W.scanCount = (W.scanCount or 0) + 1
        scanUUIDs(data, "WildChanged")
    end

    if data.reset then
        table.clear(W.Units)
        table.clear(W.Dead)
        table.clear(W.Eggs)
    end

    if type(data.units) == "table" then
        for id, info in pairs(data.units) do
            if info == false then
                markDead(id)
            elseif type(info) == "table" then
                local u = W.Units[id] or {}
                for k, v in pairs(info) do u[k] = v end
                W.Units[id] = u
                if u.health and u.health <= 0 then markDead(id) end
            end
        end
    end

    if type(data.removed) == "table" then
        for _, id in pairs(data.removed) do markDead(id) end
    end

    if type(data.eggs) == "table" then
        for _, entry in pairs(data.eggs) do
            if type(entry) == "table" and entry.id then
                local e = W.Eggs[entry.id] or {}
                e.slot = entry.id
                e.tier = entry.tier or e.tier
                e.enemyId = entry.enemyId or e.enemyId
                e.position = entry.position or e.position
                if type(entry.egg) == "table" then
                    for k, v in pairs(entry.egg) do e[k] = v end
                end
                W.Eggs[entry.id] = e
            end
        end
    end

    if type(data.egg) == "table" and data.eggId then
        log(string.format("เก็บแล้ว: %s  %s%s  ดาว %s  สถานะ %s",
            tostring(data.eggId), tostring(data.egg.kind),
            data.egg.shiny and (" " .. tostring(data.egg.shiny)) or "",
            tostring(data.egg.hatchStars), tostring(data.egg.state)))
        W.claimed = true
    end
end))

-- ดักการกดของเกมเอง: จับ id รอบ + เลข sequence ล่าสุด
-- (hook ติดตั้งครั้งเดียว แต่เรียกฟังก์ชันล่าสุดผ่าน getgenv เสมอ → รันสคริปต์ใหม่ก็ยังใช้ได้)
getgenv().WildAutoOnCall = function(a1, a2)
    local A = getgenv().WildAuto
    if not A or type(a2) ~= "table" then return end
    if type(a2.id) == "string" and a2.id:match(UUID_PAT)
        and (a1 == "Attack" or a1 == "ClaimEgg") then
        setRunId(a2.id, "การกด " .. tostring(a1) .. " ของเกม")
    end
    if a1 == "Attack" and type(a2.sequence) == "number" then
        A.seq = math.max(A.seq, a2.sequence)
    end
end

local hookOk = pcall(function()
    if getgenv().WildAutoHookV3 then return end
    getgenv().WildAutoHookV3 = true
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        -- สำคัญ: ห้ามเรียก method ของ Instance ก่อน old(...) ไม่งั้นคำสั่งของเกมจะเพี้ยน
        if self == Request and not checkcaller() and getnamecallmethod() == "InvokeServer" then
            local f = getgenv().WildAutoOnCall
            if f then
                local a1, a2 = ...
                task.spawn(pcall, f, a1, a2) -- ทำทีหลัง ไม่ยุ่งกับคำสั่งของเกม
            end
        end
        return old(self, ...)
    end)
end)
if not hookOk then
    log("executor ไม่รองรับ hookmetamethod — จะหา id รอบจากข้อมูลเกมแทน")
end

