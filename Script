-- สวิตช์เปิด/ปิด
local function toggle(parent, title, desc, key, onChange)
    local r = row(parent, title, desc)
    local sw = new("TextButton", { Size = UDim2.fromOffset(38, 20), Position = UDim2.new(1, -52, 0.5, -10),
        BackgroundColor3 = C.off, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, r)
    corner(sw, 10)
    local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sw)
    corner(knob, 8)

    local function render(instant)
        local on = CFG[key] and true or false
        local pos = on and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
        local col = on and C.accent or C.off
        if instant then
            knob.Position, sw.BackgroundColor3 = pos, col
        else
            TweenService:Create(knob, TWEEN, { Position = pos }):Play()
            TweenService:Create(sw, TWEEN, { BackgroundColor3 = col }):Play()
        end
    end
    sw.MouseButton1Click:Connect(function()
        CFG[key] = not CFG[key]
        render(false)
        if onChange then onChange(CFG[key]) end
    end)
    render(true)
    table.insert(refreshers, function() render(true) end)
    return r
end

-- ตัวเลข [-] ค่า [+]
local function stepper(parent, title, desc, key, step, minV, maxV, fmt, nilAt)
    local r = row(parent, title, desc)
    local box = new("Frame", { Size = UDim2.fromOffset(112, 26), Position = UDim2.new(1, -126, 0.5, -13),
        BackgroundColor3 = C.bg, BorderSizePixel = 0 }, r)
    corner(box, 5)
    stroke(box)
    local minus = new("TextButton", { Size = UDim2.fromOffset(28, 26), BackgroundTransparency = 1, Font = FONT_B,
        TextSize = 15, TextColor3 = C.sub, Text = "-" }, box)
    local plus = new("TextButton", { Size = UDim2.fromOffset(28, 26), Position = UDim2.new(1, -28, 0, 0),
        BackgroundTransparency = 1, Font = FONT_B, TextSize = 15, TextColor3 = C.sub, Text = "+" }, box)
    local val = new("TextLabel", { Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(28, 0),
        BackgroundTransparency = 1, Font = MONO, TextSize = 13, TextColor3 = C.text, Text = "" }, box)

    local function render()
        local v = CFG[key]
        if v == nil then
            val.Text = "off"
            val.TextColor3 = C.faint
        else
            val.Text = fmt and string.format(fmt, v) or tostring(v)
            val.TextColor3 = C.text
        end
    end
    local function change(dir)
        local v = CFG[key]
        if v == nil then
            v = (dir > 0) and minV or nil
        else
            v = math.floor((v + step * dir) / step + 0.5) * step
            if nilAt and v < minV then v = nil
            elseif v < minV then v = minV end
            if v and v > maxV then v = maxV end
        end
        CFG[key] = v
        render()
    end
    minus.MouseButton1Click:Connect(function() change(-1) end)
    plus.MouseButton1Click:Connect(function() change(1) end)
    render()
    table.insert(refreshers, render)
    return r
end

