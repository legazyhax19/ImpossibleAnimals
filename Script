-- เลือกเป้าหมาย + ตี
task.spawn(function()
    local lastTarget
    while W.running do
        if W.InWild then
            local target = getTarget()
            W.curTarget = target
            if target ~= lastTarget and target and CFG.AUTO_ATTACK then
                local u = W.Units[target]
                log(string.format("เป้าหมาย: %s (%s Lv.%s)", target, u and u.entry and u.entry.name or "?",
                    tostring(u and u.entry and u.entry.level or "?")))
            end
            lastTarget = target

            if CFG.AUTO_ATTACK and target and not W.claimGoal then
                local u = W.Units[target]
                local d = u and distTo(u.position) or math.huge
                local inRange = d <= CFG.ATTACK_RANGE or ((W.stuck or not CFG.AUTO_MOVE) and d <= CFG.STUCK_RANGE)
                if inRange then
                    if ensureRunId(target) then
                        attack(target, u.position)
                        if W.runIdGuess then
                            local hp = u.health or 0
                            W.guessHp = W.guessHp or hp
                            W.guessAttacks += 1
                            if hp < W.guessHp or not isAlive(target) then
                                W.runIdGuess = false
                                log("ได้ id ของรอบแล้ว (เดาถูก)")
                            elseif W.guessAttacks >= 8 then
                                W.runId = nil
                            end
                        end
                    end
                    task.wait(CFG.ATTACK_DELAY)
                else
                    task.wait(0.2)
                end
            else
                task.wait(0.25)
            end
        else
            W.curTarget = nil
            task.wait(0.5)
        end
    end
end)

