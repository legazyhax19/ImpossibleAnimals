-- UI: แท็บ EGGS / UNITS + แถบสถานะ
---------------------------------------------------------------------
local C = Term.C
local hex, esc = Term.hex, Term.esc

local KIND_COLOR = {
    common = "#9d9d9d", rare = "#3b8eea", epic = "#d670d6",
    legendary = "#e5c07b", mythic = "#f14c4c",
}
local SHINY_COLOR = { golden = "#e5c07b", diamond = "#29b8db" }

local function pad(s, n)
    s = tostring(s)
    if #s >= n then return s end
    return s .. string.rep(" ", n - #s)
end

local function renderEggs()
    local list = eggList()
    local lines = {}
    table.insert(lines, '<font color="#858585">' .. esc(string.format("%-7s %-5s %-10s %-8s %-4s %-6s %-6s %s",
        "EGG", "TIER", "KIND", "SHINY", "STAR", "ENEMY", "DIST", "")) .. '</font>')
    if #list == 0 then
        table.insert(lines, '<font color="#5a5a5a">ยังไม่มีข้อมูลไข่ — เข้าโซน Wild ก่อน</font>')
    end
    local failNum = getgenv().WildAutoFailNum
    for _, e in ipairs(list) do
        local kc = KIND_COLOR[tostring(e.kind)] or "#cccccc"
        local sc = e.shiny and (SHINY_COLOR[tostring(e.shiny)] or "#e5c07b") or "#5a5a5a"
        local isTarget = W.curEgg and W.curEgg.slot == e.slot
        local tooHard = failNum and enemyNum(e.enemyId) >= failNum
        local mark = ""
        if isTarget then
            mark = '<font color="#23d18b">&lt;&lt; target</font>'
        elseif W.Dead[e.enemyId] then
            mark = '<font color="#5a5a5a">enemy dead</font>'
        elseif tooHard then
            mark = '<font color="#f14c4c">too hard</font>'
        end
        local dist = distTo(e.position)
        table.insert(lines, string.format(
            '<font color="#cccccc">%s</font> <font color="#858585">%s</font> <font color="%s">%s</font> <font color="%s">%s</font> <font color="#e5c07b">%s</font> <font color="#29b8db">%s</font> <font color="#858585">%s</font> %s',
            esc(pad(e.slot, 7)), esc(pad(e.tier, 5)), kc, esc(pad(e.kind, 10)),
            sc, esc(pad(e.shiny or "-", 8)), esc(pad(e.hatchStars, 4)), esc(pad(e.enemyId, 6)),
            esc(pad(dist == math.huge and "-" or string.format("%.0f", dist), 6)), mark))
    end
    Term.SetLines("EGGS", lines)
end

local function renderUnits()
    local list = {}
    for id, u in pairs(W.Units) do
        if isAlive(id) then
            table.insert(list, { id = id, u = u, d = distTo(u.position) })
        end
    end
    table.sort(list, function(a, b) return enemyNum(a.id) < enemyNum(b.id) end)
    local lines = {}
    table.insert(lines, '<font color="#858585">' .. esc(string.format("%-5s %-15s %-12s %-5s %-18s %s",
        "ID", "NAME", "LEVEL", "TIER", "HP", "DIST")) .. '</font>')
    if #list == 0 then
        table.insert(lines, '<font color="#5a5a5a">ยังไม่มีข้อมูลสัตว์ — เข้าโซน Wild ก่อน</font>')
    end
    for _, it in ipairs(list) do
        local u = it.u
        local hp, maxHp = math.floor(u.health or 0), math.floor(u.maxHealth or 0)
        local pct = maxHp > 0 and hp / maxHp or 1
        local hpCol = pct > 0.6 and "#23d18b" or (pct > 0.3 and "#e5c07b" or "#f14c4c")
        local isCur = W.curTarget == it.id
        table.insert(lines, string.format(
            '<font color="%s">%s</font> <font color="#cccccc">%s</font> <font color="#858585">%s</font> <font color="#858585">%s</font> <font color="%s">%s</font> <font color="#858585">%s</font>%s',
            isCur and "#23d18b" or "#3b8eea", esc(pad(it.id, 5)),
            esc(pad(u.entry and u.entry.name or "?", 15)),
            esc(pad("Lv." .. tostring(u.entry and u.entry.level or "?"), 12)),
            esc(pad(u.tier or "?", 5)), hpCol, esc(pad(hp .. "/" .. maxHp, 18)),
            it.d == math.huge and "-" or string.format("%.0f", it.d),
            isCur and '  <font color="#23d18b">&lt;&lt; attacking</font>' or ""))
    end
    Term.SetLines("UNITS", lines)
end

Term.OnTab = function(name)
    if name == "EGGS" then renderEggs() elseif name == "UNITS" then renderUnits() end
end

local function updateStatus()
    local parts = {}
    if W.active then
        table.insert(parts, "● RUNNING")
        Term.SetStatusColor(C.accent)
    else
        table.insert(parts, "○ IDLE")
        Term.SetStatusColor(Color3.fromRGB(60, 60, 60))
    end
    table.insert(parts, "round " .. tostring((W.restarts or 0) + (W.active and 1 or 0)) .. "/" .. tostring(CFG.MAX_RESTARTS + 1))
    if W.curEgg then
        table.insert(parts, "target " .. tostring(W.curEgg.slot) .. " (" .. tostring(W.curEgg.enemyId) .. ")")
    end
    if W.curTarget then table.insert(parts, "hitting " .. tostring(W.curTarget)) end
    table.insert(parts, "id " .. (W.runId and "OK" or "--"))
    table.insert(parts, "atk " .. tostring(W.attackCount or 0))
    if getgenv().WildAutoFailNum then
        table.insert(parts, "limit &lt; e" .. tostring(getgenv().WildAutoFailNum))
    end
    Term.SetStatus(table.concat(parts, "   |   "))
end

task.spawn(function()
    while Term.Gui and Term.Gui.Parent and W.running do
        pcall(updateStatus)
        if Term.Current == "EGGS" then pcall(renderEggs)
        elseif Term.Current == "UNITS" then pcall(renderUnits) end
        task.wait(1)
    end
end)

