-- การกระทำ
---------------------------------------------------------------------
local function attack(targetId, targetPos)
    local root = getRoot()
    if not root or not W.runId then return false end
    local dir = flat(targetPos) - flat(root.Position)
    dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 0, -1)
    W.seq += 1
    local ok, res = pcall(function()
        return Request:InvokeServer("Attack", {
            id = W.runId,
            direction = dir,
            sequence = W.seq,
            targetId = targetId,
        })
    end)
    W.attackCount = (W.attackCount or 0) + 1
    if not ok then
        log("Attack error:", res)
    elseif CFG.DEBUG_ATTACK and (W.attackCount <= 5 or W.attackCount % 20 == 0) then
        local u = W.Units[targetId]
        local resText = tostring(res)
        if type(res) == "table" then
            local parts = {}
            for k, v in pairs(res) do table.insert(parts, tostring(k) .. "=" .. tostring(v)) end
            resText = "{" .. table.concat(parts, ", ") .. "}"
        end
        log(string.format("ตีครั้งที่ %d → %s  seq=%d  ระยะ %.0f  HP สัตว์ %s  ผล=%s",
            W.attackCount, targetId, W.seq, distTo(targetPos),
            tostring(u and math.floor(u.health or 0) or "?"), resText))
    end
    return ok, res
end

-- เข้าใกล้ตำแหน่ง (เรียกซ้ำในลูปได้) คืนค่า true ถ้าถึงระยะแล้ว
local function approach(pos, range)
    local root, hum = getRoot()
    if not root or typeof(pos) ~= "Vector3" then return false end
    if distTo(pos) <= range then return true end

    if CFG.TELEPORT then
        local from = flat(root.Position)
        local to = flat(pos)
        local back = (from - to)
        back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)
        local stand = to + back * math.max(range - 3, 2)
        local y = root.Position.Y
        root.CFrame = CFrame.new(Vector3.new(stand.X, y, stand.Z), Vector3.new(to.X, y, to.Z))
        task.wait(0.1)
    elseif hum then
        hum:MoveTo(Vector3.new(pos.X, root.Position.Y, pos.Z))
    end
    return distTo(pos) <= range
end

local function claimEgg(slot)
    local ok, res = pcall(function()
        return Request:InvokeServer("ClaimEgg", {
            id = W.runId or guid(),
            returning = CFG.RETURN_AFTER,
            eggId = slot,
        })
    end)
    log("ClaimEgg", slot, ok, res)
    return ok
end

-- หาโมเดลไข่ที่ดรอปแล้วของเรา จากสัตว์ตัวนี้
local function findDroppedEgg(enemyId)
    local ial = workspace:FindFirstChild("ImpossibleAnimalsLocal")
    local vis = ial and ial:FindFirstChild("WildVisuals")
    local sw = vis and vis:FindFirstChild("StreamedWilderness")
    local folder = sw and sw:FindFirstChild("WildEggs")
    if not folder then return nil end
    for _, m in ipairs(folder:GetChildren()) do
        if m:GetAttribute("EnemyId") == enemyId and m:GetAttribute("OwnerUserId") == player.UserId then
            return m
        end
    end
end

---------------------------------------------------------------------
-- เลือกไข่
---------------------------------------------------------------------
local function eggList()
    local list = {}
    for _, e in pairs(W.Eggs) do table.insert(list, e) end
    table.sort(list, function(a, b)
        local sa, sb = a.hatchStars or 0, b.hatchStars or 0
        if sa ~= sb then return sa > sb end
        local ha, hb = a.shiny and 1 or 0, b.shiny and 1 or 0
        if ha ~= hb then return ha > hb end
        return (a.tier or 0) < (b.tier or 0)
    end)
    return list
end

local function printEggs(list)
    print("")
    print("================ ไข่ในโซน (" .. #list .. " ใบ) ================")
    print(string.format("%-7s %-5s %-10s %-8s %-5s %-6s %s", "ไข่", "tier", "ชนิด", "shiny", "ดาว", "สัตว์", "ห่าง"))
    for _, e in ipairs(list) do
        print(string.format("%-7s %-5s %-10s %-8s %-5s %-6s %.0f",
            tostring(e.slot), tostring(e.tier), tostring(e.kind),
            e.shiny and tostring(e.shiny) or "-", tostring(e.hatchStars),
            tostring(e.enemyId), distTo(e.position)))
    end
    print("============================================================")
end

local function chooseEgg(list)
    if CFG.TARGET_EGG and W.Eggs[CFG.TARGET_EGG] then
        return W.Eggs[CFG.TARGET_EGG]
    end
    for _, e in ipairs(list) do
        if not CFG.MAX_EGG_TIER or (e.tier or 0) <= CFG.MAX_EGG_TIER then
            return e
        end
    end
end

-- สัตว์ตัวถัดไปที่ต้องตี
local function nextEnemy(targetEnemy)
    if not CFG.KILL_IN_ORDER then
        return isAlive(targetEnemy) and targetEnemy or nil
    end
    local limit = enemyNum(targetEnemy)
    local best, bestN
    for id in pairs(W.Units) do
        local n = enemyNum(id)
        if n <= limit and isAlive(id) and (not bestN or n < bestN) then
            best, bestN = id, n
        end
    end
    return best
end

---------------------------------------------------------------------
-- STEP 1: กด Wild + เลือกตัว
---------------------------------------------------------------------
local function autoStart()
    log("กด Wild...")
    local ok, res = pcall(function()
        return Request:InvokeServer("Create", { teleport = true })
    end)
    if ok then scanUUIDs(res, "Create") end
    if not ok then
        log("Create error:", res)
        return false
    end

    local creatures
    pcall(function()
        creatures = player:WaitForChild("PlayerGui")
            :WaitForChild("ImpossibleAnimals", 10):WaitForChild("Root", 10)
            :WaitForChild("WildPicker", 10):WaitForChild("Popup", 10)
            :WaitForChild("Creatures", 10)
    end)
    if not creatures then
        log("ไม่เจอหน้าเลือกตัวละคร")
        return false
    end

    local card
    for _ = 1, 40 do
        card = creatures:FindFirstChild("Creature" .. CFG.PICK)
        if card and card:GetAttribute("CreatureId") then break end
        task.wait(0.25)
    end
    if not card or not card:GetAttribute("CreatureId") then
        log("ไม่เจอ Creature" .. CFG.PICK)
        return false
    end
    task.wait(0.5)

    local name = card:FindFirstChild("Content") and card.Content:FindFirstChild("Title")
        and card.Content.Title:FindFirstChild("CreatureName")
    log("เลือก Creature" .. CFG.PICK, name and name.Text or "")

    -- UUID ของตัวละครทุกตัวไม่ใช่ id รอบ
    for _, c in ipairs(creatures:GetChildren()) do
        local cid = c:GetAttribute("CreatureId")
        if cid then W.creatureIds[cid] = true end
    end
    local ok2, res2 = pcall(function()
        return Request:InvokeServer("Ready", { card:GetAttribute("CreatureId") })
    end)
    if ok2 then scanUUIDs(res2, "Ready") end
    if not ok2 then
        log("Ready error:", res2)
        return false
    end
    return true
end

