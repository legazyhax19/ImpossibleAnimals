    -- หน้า Logs (สร้างไว้ก่อน เพื่อให้ print ใช้ได้ตั้งแต่แรก)
    ---------------------------------------------------------------
    local logBox -- ScrollingFrame ใส่ log
    local MAX_LINES = 200
    local order, count = 0, 0
    local pendingLogs = {}

    function Term.AttachLogBox(sf)
        logBox = sf
        for _, item in ipairs(pendingLogs) do Term.Print(item[1], item[2], item[3]) end
        pendingLogs = {}
    end

    local function autoColor(s)
        local l = s:lower()
        if l:find("error") or s:find("ตาย") or s:find("หลุด") or s:find("ไม่เจอ")
            or s:find("ไม่ได้") or s:find("ไม่เข้า") or s:find("ไม่มี") then
            return C.red
        elseif s:find("เสร็จ") or s:find("ได้ id") or s:find("ถูกต้อง") or s:find("เก็บแล้ว")
            or s:find("ฆ่า") or s:find("พร้อม") then
            return C.green
        elseif s:find("เป้าหมาย") or s:find("ไปตี") or s:find("เริ่ม") or s:find("เลือก") then
            return C.yellow
        elseif s:match("^%s*[=%-]+") or s:find("ตีครั้งที่") or s:find("กำลังเดิน") then
            return C.faint
        end
        return C.text
    end

    function Term.Print(s, color, raw)
        if not gui.Parent then return end
        s = tostring(s):gsub("^%[Auto%]%s*", "")
        if not logBox then
            table.insert(pendingLogs, { s, color, raw })
            return
        end
        color = color or autoColor(s)
        order += 1
        count += 1
        local atBottom = logBox.CanvasPosition.Y >= logBox.AbsoluteCanvasSize.Y - logBox.AbsoluteSize.Y - 30
        new("TextLabel", {
            Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Font = MONO, TextSize = 12, RichText = true, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, LayoutOrder = order,
            Text = '<font color="#5f5f5f">' .. os.date("%H:%M:%S") .. '</font>  ' .. (raw and s or esc(s)),
        }, logBox)
        if count > MAX_LINES then
            local oldest, oldestOrder
            for _, ch in ipairs(logBox:GetChildren()) do
                if ch:IsA("TextLabel") and (not oldestOrder or ch.LayoutOrder < oldestOrder) then
                    oldest, oldestOrder = ch, ch.LayoutOrder
                end
            end
            if oldest then
                oldest:Destroy()
                count -= 1
            end
        end
        if atBottom then
            task.defer(function()
                logBox.CanvasPosition = Vector2.new(0, math.max(0, logBox.AbsoluteCanvasSize.Y - logBox.AbsoluteSize.Y))
            end)
        end
        if Term.OnLog then pcall(Term.OnLog, s, color) end
    end

    function Term.Clear()
        if not logBox then return end
        for _, ch in ipairs(logBox:GetChildren()) do
            if ch:IsA("TextLabel") then ch:Destroy() end
        end
        count = 0
    end

    function Term.Destroy()
        for _, c in ipairs(Term._conns or {}) do pcall(function() c:Disconnect() end) end
        pcall(function() gui:Destroy() end)
        if getgenv().WildTermGui == gui then getgenv().WildTermGui = nil end
    end
end

-- ส่ง print ทั้งหมดในสคริปต์นี้ไปที่หน้า Logs (และ console ด้วย)
local rawprint = print
local function print(...)
    local n = select("#", ...)
    local parts = {}
    for i = 1, n do parts[i] = tostring((select(i, ...))) end
    local s = table.concat(parts, " ")
    rawprint(s)
    Term.Print(s)
end

