-- เลือกเป้าหมาย / กรองไข่
---------------------------------------------------------------------
local KINDS = { "common", "rare", "epic", "legendary", "mythic" }
local KIND_RANK = {}
for i, k in ipairs(KINDS) do KIND_RANK[k] = i end

local function unitTier(id, u)
    if u and tonumber(u.tier) then return tonumber(u.tier) end
    for _, e in pairs(W.Eggs) do
        if e.enemyId == id and e.tier then return e.tier end
    end
    return math.huge
end

-- สัตว์ตัวถัดไป: เลขน้อยสุดที่ยังไม่ตาย และอยู่ในโซนที่ตั้งไว้
local function getTarget()
    local best, bn
    for id, u in pairs(W.Units) do
        if isAlive(id) and unitTier(id, u) <= CFG.MAX_ZONE then
            local n = enemyNum(id)
            if not bn or n < bn then best, bn = id, n end
        end
    end
    return best
end

-- ไข่ผ่านไหม: (ระดับถึง และ ดาวถึง) หรือ มีสถานะที่เลือก
local function eggPasses(e)
    if e.shiny and CFG.SHINY[tostring(e.shiny):lower()] then return true end
    local rank = KIND_RANK[tostring(e.kind)] or 0
    return rank >= (KIND_RANK[CFG.MIN_KIND] or 1) and (e.hatchStars or 0) >= (CFG.MIN_STARS or 0)
end

local function eggInZone(e) return (e.tier or math.huge) <= CFG.MAX_ZONE end

local function betterEgg(a, b)
    local sa, sb = a.hatchStars or 0, b.hatchStars or 0
    if sa ~= sb then return sa > sb end
    local ra, rb = KIND_RANK[tostring(a.kind)] or 0, KIND_RANK[tostring(b.kind)] or 0
    if ra ~= rb then return ra > rb end
    return (a.shiny and 1 or 0) > (b.shiny and 1 or 0)
end

local function plannedEgg()
    local best
    for _, e in pairs(W.Eggs) do
        if eggInZone(e) and eggPasses(e) and not W.Claimed[e.slot] then
            if not best or betterEgg(e, best) then best = e end
        end
    end
    return best
end

-- หาโมเดลไข่ในฉาก (ถ้าโหลดมาแล้ว) เพื่อเอาตำแหน่งที่แม่นกว่า
local function eggModel(e)
    local ial = workspace:FindFirstChild("ImpossibleAnimalsLocal")
    local vis = ial and ial:FindFirstChild("WildVisuals")
    local sw = vis and vis:FindFirstChild("StreamedWilderness")
    local folder = sw and sw:FindFirstChild("WildEggs")
    if not folder then return nil end
    for _, m in ipairs(folder:GetChildren()) do
        if m:GetAttribute("EnemyId") == e.enemyId and m:GetAttribute("OwnerUserId") == player.UserId then
            return m
        end
    end
end

local function toVec(v)
    if typeof(v) == "Vector3" then return v end
    if typeof(v) == "CFrame" then return v.Position end
end

local function resetCharacter()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
    if char then pcall(function() char:BreakJoints() end) end
end

