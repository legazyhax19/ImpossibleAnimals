local function renderUnits()
    local list = {}
    for id, u in pairs(W.Units) do
        if isAlive(id) then table.insert(list, { id = id, u = u, d = distTo(u.position) }) end
    end
    table.sort(list, function(a, b) return enemyNum(a.id) < enemyNum(b.id) end)
    local items = {}
    if #list == 0 then
        table.insert(items, { Text = '<font color="#5f5f5f">ยังไม่มีข้อมูลสัตว์ — เข้าโซน Wild ก่อน</font>' })
