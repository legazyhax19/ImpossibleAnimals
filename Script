local function autoStart()
    log("กด Wild...")
    local ok, res = pcall(function()
        return Request:InvokeServer("Create", { teleport = true })
    end)
    if ok then scanUUIDs(res, "Create") end
    if not ok then
        log("Create error:", res)
        return false
    end

    local creatures
    pcall(function()
        creatures = player:WaitForChild("PlayerGui")
            :WaitForChild("ImpossibleAnimals", 10):WaitForChild("Root", 10)
            :WaitForChild("WildPicker", 10):WaitForChild("Popup", 10)
            :WaitForChild("Creatures", 10)
    end)
    if not creatures then
        log("ไม่เจอหน้าเลือกตัวละคร")
        return false
    end

    local card
    for _ = 1, 40 do
        card = creatures:FindFirstChild("Creature" .. CFG.PICK)
        if card and card:GetAttribute("CreatureId") then break end
        task.wait(0.25)
    end
    if not card or not card:GetAttribute("CreatureId") then
        log("ไม่เจอ Creature" .. CFG.PICK)
        return false
    end
    task.wait(0.5)

    local name = card:FindFirstChild("Content") and card.Content:FindFirstChild("Title")
        and card.Content.Title:FindFirstChild("CreatureName")
    log("เลือก Creature" .. CFG.PICK, name and name.Text or "")

