    for _, it in ipairs(list) do
        local u = it.u
        local hp, maxHp = math.floor(u.health or 0), math.floor(u.maxHealth or 0)
        local pct = maxHp > 0 and hp / maxHp or 1
        local hpCol = pct > 0.6 and "#23d18b" or (pct > 0.3 and "#e5c07b" or "#f14c4c")
        local cur = W.curTarget == it.id
        local sel = CFG.TARGET_ENEMY == it.id
        table.insert(items, { Id = it.id, Text = string.format(
            '%s <font color="%s">%s</font> <font color="#e6e6e6">%s</font> <font color="#969696">%s</font> <font color="%s">%s</font> <font color="#5f5f5f">%s</font>%s',
