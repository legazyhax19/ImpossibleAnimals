local function markDead(id)
    if not W.Dead[id] then
        W.Dead[id] = true
        local u = W.Units[id]
        log(string.format("ฆ่า %s (%s) แล้ว", id, u and u.entry and u.entry.name or "?"))
    end
    W.Units[id] = nil
end

