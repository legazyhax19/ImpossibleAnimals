local function parseValue(v)
    if v == nil or v == "nil" then return nil end
    if v == "true" then return true end
    if v == "false" then return false end
    return tonumber(v) or v
end

local HELP = {
    { "start",            "เริ่มทำงาน (กด Wild → ตี → เก็บไข่)" },
    { "stop",             "หยุดทำงาน" },
    { "eggs / units",     "เปิดแท็บไข่ / สัตว์" },
    { "target <egg|auto>","บังคับเลือกไข่ เช่น target egg4" },
    { "pick <n>",         "เลือก Creature ลำดับที่ n" },
    { "maxtier <n|nil>",  "จำกัด tier ไข่สูงสุด" },
    { "tp on/off",        "วาร์ป / เดิน" },
    { "resetfail",        "ล้างค่าที่จำว่าสู้ตัวไหนไม่ไหว" },
    { "set <KEY> <val>",  "แก้ค่าตั้งค่า เช่น set ATTACK_DELAY 0.3" },
    { "config",           "ดูค่าตั้งค่าทั้งหมด" },
    { "clear",            "ล้างหน้าจอ" },
    { "close",            "ปิดทุกอย่าง" },
}

local function printHelp()
    Term.Print("คำสั่งที่ใช้ได้:", C.cyan)
    for _, h in ipairs(HELP) do
        Term.Print('  <font color="#23d18b">' .. esc(pad(h[1], 18)) .. '</font> <font color="#858585">' .. esc(h[2]) .. '</font>', C.text, true)
    end
end

Term.OnCommand = function(line)
    local args = {}
    for w in line:gmatch("%S+") do table.insert(args, w) end
    local cmd = (args[1] or ""):lower()

    if cmd == "help" or cmd == "?" then
        printHelp()
    elseif cmd == "start" or cmd == "run" then
        W.Start()
    elseif cmd == "stop" then
        W.Halt()
    elseif cmd == "eggs" then
        Term.SelectTab("EGGS")
    elseif cmd == "units" then
        Term.SelectTab("UNITS")
    elseif cmd == "clear" or cmd == "cls" then
        Term.Clear()
    elseif cmd == "target" then
        local v = args[2]
        CFG.TARGET_EGG = (v == nil or v == "auto" or v == "nil") and nil or v
        Term.Print("TARGET_EGG = " .. tostring(CFG.TARGET_EGG), C.green)
    elseif cmd == "pick" then
        CFG.PICK = tonumber(args[2]) or 1
        Term.Print("PICK = Creature" .. CFG.PICK, C.green)
    elseif cmd == "maxtier" then
        CFG.MAX_EGG_TIER = tonumber(args[2])
        Term.Print("MAX_EGG_TIER = " .. tostring(CFG.MAX_EGG_TIER), C.green)
    elseif cmd == "tp" then
        CFG.TELEPORT = (args[2] == "on" or args[2] == "true")
        Term.Print("TELEPORT = " .. tostring(CFG.TELEPORT), C.green)
    elseif cmd == "resetfail" then
        getgenv().WildAutoFailNum = nil
        Term.Print("ล้างค่าที่จำไว้แล้ว", C.green)
    elseif cmd == "set" then
        local key = args[2] and args[2]:upper()
        if not key or CFG[key] == nil and not ({ MAX_EGG_TIER = 1, TARGET_EGG = 1 })[key] then
            Term.Print("ไม่มีค่า " .. tostring(args[2]) .. " — พิมพ์ config เพื่อดูชื่อ", C.red)
            return
        end
        CFG[key] = parseValue(args[3])
        Term.Print(key .. " = " .. tostring(CFG[key]), C.green)
    elseif cmd == "config" then
        local keys = {}
        for k in pairs(CFG) do table.insert(keys, k) end
        table.insert(keys, "MAX_EGG_TIER")
        table.insert(keys, "TARGET_EGG")
        table.sort(keys)
        local seen = {}
        for _, k in ipairs(keys) do
            if not seen[k] then
                seen[k] = true
                Term.Print('  <font color="#3b8eea">' .. esc(pad(k, 16)) .. '</font> ' .. esc(tostring(CFG[k])), C.text, true)
            end
        end
    elseif cmd == "close" or cmd == "exit" then
        W.Stop()
    else
        Term.Print("ไม่รู้จักคำสั่ง: " .. cmd .. " — พิมพ์ help", C.red)
    end
end

