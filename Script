-- หา id ของรอบ
---------------------------------------------------------------------
local UUID_PAT = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

local function addCandidate(id, where)
    if W.runId or W.creatureIds[id] then return end
    for _, c in ipairs(W.candidates) do
        if c.id == id then return end
    end
    table.insert(W.candidates, { id = id, where = where })
    print("[Auto] เจอ id ที่อาจเป็นของรอบ: " .. id .. "  (จาก " .. where .. ")")
end

local function scanUUIDs(v, path, depth)
    depth = depth or 0
    if depth > 4 then return end
    if type(v) == "string" then
        if v:match(UUID_PAT) then addCandidate(v, path) end
    elseif type(v) == "table" then
        for k, val in pairs(v) do
            -- ข้ามข้อมูลสัตว์/ไข่/หีบ (ยาวและไม่น่ามี)
            if not (depth == 0 and (k == "units" or k == "eggs" or k == "chests")) then
                if type(k) == "string" and k:match(UUID_PAT) then addCandidate(k, path .. "[key]") end
                scanUUIDs(val, path .. "." .. tostring(k), depth + 1)
            end
        end
    end
end

local function setRunId(id, where)
    if W.runId ~= id then
        W.runId = id
        W.runIdGuess = false
        print("[Auto] ได้ id ของรอบแล้ว: " .. id .. "  (จาก " .. where .. ")")
    end
end

