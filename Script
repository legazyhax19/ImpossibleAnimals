-- Auto Attack
task.spawn(function()
    while W.running do
        if W.InWild and not W.entering then
            local target = getTarget()
            W.curTarget = target
            W.curEgg = plannedEgg()

            if CFG.AUTO_ATTACK and target and not W.claimGoal then
                local u = W.Units[target]
                local d = u and distTo(u.position) or math.huge
                local now = os.clock()

                -- กันล็อคเป้าค้าง: เปลี่ยนเป้า → เริ่มนับใหม่
                if target ~= W.wdTarget then
                    W.wdTarget, W.wdHp, W.wdTime, W.wdSince = target, u and u.health, now, now
                end
                if u and u.health ~= W.wdHp then
                    W.wdHp, W.wdTime = u.health, now
                    W.skips = 0
                end
                local hitStuck = W.runId and not W.runIdGuess and now - W.wdTime > 8
                local walkStuck = now - W.wdSince > 25 and W.wdHp == (u and u.health)
                if hitStuck or walkStuck then
                    W.Dead[target] = true
                    W.wdTarget = nil
                    W.skips = (W.skips or 0) + 1
                    log("ข้าม " .. target .. " (ตีไม่ลด)")
                    if W.skips >= 3 then
                        W.skips = 0
                        leaveZone("ตีไม่เข้าหลายตัวติดกัน — ถือว่าออกจากโซน")
                    end
                elseif d <= CFG.ATTACK_RANGE or (W.stuck and d <= CFG.STUCK_RANGE) then
                    if ensureRunId(target) then
                        attack(target, u.position)
                        if W.runIdGuess then
                            local hp = u.health or 0
                            W.guessHp = W.guessHp or hp
                            W.guessAttacks = (W.guessAttacks or 0) + 1
                            if hp < W.guessHp or not isAlive(target) then
                                W.runIdGuess = false
                            elseif W.guessAttacks >= 8 then
                                W.runId = nil
                            end
                        end
                    end
                    task.wait(CFG.ATTACK_DELAY)
                else
                    task.wait(0.2)
                end
            else
                task.wait(0.25)
            end
        else
            W.curTarget = nil
            task.wait(0.5)
        end
    end
end)

-- เดิน (เปิดตลอด) : ไข่ → สัตว์
task.spawn(function()
    while W.running do
        if W.InWild and not W.entering then
            if W.claimGoal then
                approach(W.claimGoal, 5)
            elseif CFG.AUTO_ATTACK and W.curTarget and W.Units[W.curTarget] then
                approach(W.Units[W.curTarget].position, CFG.ATTACK_RANGE)
            end
        end
        task.wait(0.2)
    end
end)

-- Auto Claim: เคลียร์โซนเสร็จ (และเก็บหีบหมด) → ไปเก็บไข่ใบดีสุดที่ผ่านเงื่อนไข
task.spawn(function()
    while W.running do
        if CFG.AUTO_CLAIM and W.InWild and not W.entering and next(W.Eggs) and not getTarget() then
            -- ไข่ที่สัตว์ตายแล้ว (= ดรอปแล้ว) และผ่านเงื่อนไข
            local best
            for _, e in pairs(W.Eggs) do
                if eggInZone(e) and eggPasses(e) and not W.Claimed[e.slot] and W.Dead[e.enemyId] then
                    if not best or betterEgg(e, best) then best = e end
                end
            end

            if best then
                W.clearedAt = nil
                local m = eggModel(best)
                local pos = (m and m:GetPivot().Position) or toVec(best.position)
                W.claimGoal = pos
                if not pos or distTo(pos) <= 6 then
                    log(string.format("เก็บไข่ %s%s %s ดาว", tostring(best.kind),
                        best.shiny and (" " .. tostring(best.shiny)) or "", tostring(best.hatchStars)))
                    claimEgg(best.slot)
                    for _ = 1, 20 do
                        if W.Claimed[best.slot] then break end
                        task.wait(0.25)
                    end
                    if not W.Claimed[best.slot] then
                        W.claimFails = (W.claimFails or 0) + 1
                        if W.claimFails >= 3 then
                            W.Claimed[best.slot] = true -- ข้ามใบนี้ กันค้าง
                            W.claimFails = 0
                        end
                    end
                    W.claimGoal = nil
                end
            else
                W.claimGoal = nil
                W.clearedAt = W.clearedAt or os.clock()
                if os.clock() - W.clearedAt > 3 and not W.noneLogged then
                    W.noneLogged = true
                    log("เคลียร์ถึงโซน " .. CFG.MAX_ZONE .. " แล้ว ไม่มีไข่ผ่านเงื่อนไข")
                    if CFG.RESET_IF_NONE then
                        log("รีเซ็ตตัวเพื่อเริ่มรอบใหม่")
                        resetCharacter()
                    end
                end
            end
        else
            W.claimGoal = nil
            if not W.InWild or getTarget() then
                W.clearedAt, W.noneLogged = nil, false
            end
        end
        task.wait(0.3)
    end
end)

