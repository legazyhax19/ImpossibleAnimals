local function eggList()
    local list = {}
    for _, e in pairs(W.Eggs) do table.insert(list, e) end
    table.sort(list, function(a, b)
        local sa, sb = a.hatchStars or 0, b.hatchStars or 0
        if sa ~= sb then return sa > sb end
        local ha, hb = a.shiny and 1 or 0, b.shiny and 1 or 0
        if ha ~= hb then return ha > hb end
        return (a.tier or 0) < (b.tier or 0)
    end)
    return list
end

local function printEggs(list)
    print("")
    print("================ ไข่ในโซน (" .. #list .. " ใบ) ================")
    print(string.format("%-7s %-5s %-10s %-8s %-5s %-6s %s", "ไข่", "tier", "ชนิด", "shiny", "ดาว", "สัตว์", "ห่าง"))
    for _, e in ipairs(list) do
        print(string.format("%-7s %-5s %-10s %-8s %-5s %-6s %.0f",
            tostring(e.slot), tostring(e.tier), tostring(e.kind),
            e.shiny and tostring(e.shiny) or "-", tostring(e.hatchStars),
            tostring(e.enemyId), distTo(e.position)))
    end
    print("============================================================")
end

local function chooseEgg(list)
    if CFG.TARGET_EGG and W.Eggs[CFG.TARGET_EGG] then
        return W.Eggs[CFG.TARGET_EGG]
    end
    local failNum = CFG.LEARN_LIMIT and getgenv().WildAutoFailNum or nil
    for _, e in ipairs(list) do
        local okTier = not CFG.MAX_EGG_TIER or (e.tier or 0) <= CFG.MAX_EGG_TIER
        local okFail = not failNum or enemyNum(e.enemyId) < failNum
        if okTier and okFail then
            return e
        end
    end
end

-- สัตว์ตัวถัดไปที่ต้องตี
local function nextEnemy(targetEnemy)
    if not CFG.KILL_IN_ORDER then
        return isAlive(targetEnemy) and targetEnemy or nil
    end
    local limit = enemyNum(targetEnemy)
    local best, bestN
    for id in pairs(W.Units) do
        local n = enemyNum(id)
        if n <= limit and isAlive(id) and (not bestN or n < bestN) then
            best, bestN = id, n
        end
    end
    return best
end

