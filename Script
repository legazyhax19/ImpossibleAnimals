        W.runId and '<font color="#23d18b">ok</font>' or '<font color="#5f5f5f">--</font>',
        tostring(W.attackCount or 0),
        getgenv().WildAutoFailNum and ("   limit &lt; e" .. getgenv().WildAutoFailNum) or "",
        esc(lastLog:sub(1, 70)))
end

