local function autoColor(s)
    local l = s:lower()
    if l:find("error") or s:find("ตาย") or s:find("หลุด") or s:find("ไม่เจอ")
        or s:find("ไม่ได้") or s:find("ไม่เข้า") or s:find("ไม่มี") then
        return Col.Red
    elseif s:find("เสร็จ") or s:find("ได้ id") or s:find("ถูกต้อง") or s:find("เก็บแล้ว")
        or s:find("ฆ่า") or s:find("พร้อม") or s:find("เข้าโซน") then
        return Col.Green
    elseif s:find("เป้าหมาย") or s:find("ไปตี") or s:find("เริ่ม") or s:find("เลือก") then
        return Col.Yellow
    elseif s:find("ตีครั้งที่") then
        return Col.Faint
    end
    return Col.Text
end

local rawprint = print
local function log(...)
    local n = select("#", ...)
    local parts = {}
    for i = 1, n do parts[i] = tostring((select(i, ...))) end
    local s = table.concat(parts, " ")
    rawprint("[Wild] " .. s)
    Log:Print(s, autoColor(s))
end

