-- หยุดการทำงาน (หน้าต่างยังเปิดอยู่)
function W.Halt()
    if W.active then
        W.active = false
        W.fighting = false
        log("สั่งหยุดแล้ว")
    end
end

-- ปิดทุกอย่าง (รวมหน้าต่าง)
function W.Stop()
    if not W.running then return end
    W.active = false
    W.running = false
    for _, c in ipairs(W.conns) do c:Disconnect() end
    if getgenv().WildAuto == W then getgenv().WildAuto = nil end
    rawprint("[Auto] ปิดแล้ว")
    Term.Destroy()
end

