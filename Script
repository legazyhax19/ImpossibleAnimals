local unitLabels = {}

local function renderUnits()
    local list = {}
    for id, u in pairs(W.Units) do
        if isAlive(id) then table.insert(list, { id = id, u = u, d = distTo(u.position) }) end
    end
    table.sort(list, function(a, b) return enemyNum(a.id) < enemyNum(b.id) end)
    local lines = {}
    if #list == 0 then
        table.insert(lines, '<font color="#5f5f5f">ยังไม่มีข้อมูลสัตว์ — เข้าโซน Wild ก่อน</font>')
    end
    for _, it in ipairs(list) do
        local u = it.u
        local hp, maxHp = math.floor(u.health or 0), math.floor(u.maxHealth or 0)
        local pct = maxHp > 0 and hp / maxHp or 1
        local hpCol = pct > 0.6 and "#23d18b" or (pct > 0.3 and "#e5c07b" or "#f14c4c")
        local isCur = W.curTarget == it.id
        table.insert(lines, string.format(
            '<font color="%s">%s</font> <font color="#e6e6e6">%s</font> <font color="#969696">%s</font> <font color="%s">%s</font> <font color="#5f5f5f">%s</font>%s',
            isCur and "#23d18b" or "#3b8eea", esc(pad(it.id, 5)),
            esc(pad(u.entry and u.entry.name or "?", 15)),
            esc(pad("Lv." .. tostring(u.entry and u.entry.level or "?"), 12)),
            hpCol, esc(pad(hp .. "/" .. maxHp, 16)),
            it.d == math.huge and "-" or string.format("%.0f", it.d),
            isCur and '  <font color="#23d18b">กำลังตี</font>' or ""))
    end
    for i, text in ipairs(lines) do
        local l = unitLabels[i]
        if not l then
            l = new("TextLabel", { Size = UDim2.new(1, -14, 0, 20), BackgroundTransparency = 1, Font = MONO,
                TextSize = 12, RichText = true, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = i }, unitBox)
            unitLabels[i] = l
        end
        l.Text = text
        l.Visible = true
    end
    for j = #lines + 1, #unitLabels do unitLabels[j].Visible = false end
end

