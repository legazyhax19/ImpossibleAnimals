-- หลุดโซน (ถูกย้ายไกลทันที) + เช็กว่าเดินติด
task.spawn(function()
    local lastPos
    local stillSince
    while W.running do
        local root = getRoot()
        if root then
            local pos = root.Position
            -- ถูกย้ายไกลทันที (เทียบกับจุดที่เราวาร์ปเองด้วย)
            local ref = lastPos
            if W.expectedPos and os.clock() - W.lastTeleport < 1 then ref = W.expectedPos end
            if ref and W.InWild and (pos - ref).Magnitude > 300 then
                leaveZone("ออกจากโซน")
            end
            lastPos = pos
            if W.InWild and pickerOpen() then leaveZone("ออกจากโซน") end
            if root.AssemblyLinearVelocity.Magnitude < 1.5 then
                stillSince = stillSince or os.clock()
            else
                stillSince = nil
            end
            W.stuck = stillSince ~= nil and os.clock() - stillSince > 0.6
        end
        task.wait(0.2)
    end
end)

