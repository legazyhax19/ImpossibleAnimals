-- เลือกไข่ / เลือกสัตว์
---------------------------------------------------------------------
local function eggList()
    local list = {}
    for _, e in pairs(W.Eggs) do table.insert(list, e) end
    table.sort(list, function(a, b)
        local sa, sb = a.hatchStars or 0, b.hatchStars or 0
        if sa ~= sb then return sa > sb end
        local ha, hb = a.shiny and 1 or 0, b.shiny and 1 or 0
        if ha ~= hb then return ha > hb end
        return (a.tier or 0) < (b.tier or 0)
    end)
    return list
end

local function eggAllowed(e)
    if W.Claimed[e.slot] then return false end
    if CFG.MAX_EGG_TIER and (e.tier or 0) > CFG.MAX_EGG_TIER then return false end
    local fail = CFG.LEARN_LIMIT and getgenv().WildAutoFailNum
    if fail and enemyNum(e.enemyId) >= fail then return false end
    return true
end

local function targetEgg()
    if CFG.TARGET_EGG then
        local e = W.Eggs[CFG.TARGET_EGG]
        if e and not W.Claimed[e.slot] then return e end
    end
    for _, e in ipairs(eggList()) do
        if eggAllowed(e) then return e end
    end
end

local function getTarget()
    local mode = CFG.TARGET_MODE
    if mode == "Selected" then
        return isAlive(CFG.TARGET_ENEMY) and CFG.TARGET_ENEMY or nil
    elseif mode == "Nearest" then
        local best, bd
        for id, u in pairs(W.Units) do
            if isAlive(id) then
                local d = distTo(u.position)
                if not bd or d < bd then best, bd = id, d end
            end
        end
        return best
    elseif mode == "Lowest" then
        local best, bn
        for id in pairs(W.Units) do
            if isAlive(id) and (not bn or enemyNum(id) < bn) then best, bn = id, enemyNum(id) end
        end
        return best
    else -- Egg
        local egg = targetEgg()
        W.curEgg = egg
        if not egg then return nil end
        if not CFG.KILL_IN_ORDER then
            return isAlive(egg.enemyId) and egg.enemyId or nil
        end
        local limit, best, bn = enemyNum(egg.enemyId), nil, nil
        for id in pairs(W.Units) do
            local n = enemyNum(id)
            if n <= limit and isAlive(id) and (not bn or n < bn) then best, bn = id, n end
        end
        return best
    end
end

