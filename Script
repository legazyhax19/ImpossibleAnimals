    -- ลากหน้าต่าง
    do
        local dragging, startPos, startInput
        top.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                startInput = input.Position
                startPos = win.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - startInput
                win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    -- ข้อความ
    local function esc(s)
        return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
    end
    Term.esc = esc
    local function hex(c)
        return string.format("#%02x%02x%02x", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
    end
    Term.hex = hex

    local function autoColor(s)
        local l = s:lower()
        if l:find("error") or s:find("ตาย") or s:find("หลุด") or s:find("ไม่เจอ")
            or s:find("ไม่ได้") or s:find("ไม่เข้า") or s:find("ไม่มี") then
            return C.red
        elseif s:find("เสร็จ") or s:find("ได้ id") or s:find("ถูกต้อง") or s:find("เก็บแล้ว")
            or s:find("ฆ่า") or s:find("พร้อม") then
            return C.green
        elseif s:find("เป้าหมาย") or s:find("ไปตี") or s:find("เริ่ม") or s:find("เลือก") then
            return C.yellow
        elseif s:match("^%s*[=%-]+") then
            return C.faint
        elseif s:find("ตีครั้งที่") or s:find("กำลังเดิน") then
            return C.dim
        end
        return C.text
    end

    local order = 0
    local count = 0
    function Term.Print(s, color, raw)
        if not gui.Parent then return end
        s = tostring(s):gsub("^%[Auto%]%s*", "")
        color = color or autoColor(s)
        order += 1
        count += 1
        local atBottom = logs.CanvasPosition.Y >= logs.AbsoluteCanvasSize.Y - logs.AbsoluteSize.Y - 30
        new("TextLabel", {
            Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Font = FONT, TextSize = 13, RichText = true, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, LayoutOrder = order,
            Text = '<font color="#5a5a5a">' .. os.date("%H:%M:%S") .. '</font>  ' .. (raw and s or esc(s)),
        }, logs)
        if count > MAX_LINES then
            local oldest, oldestOrder
            for _, ch in ipairs(logs:GetChildren()) do
                if ch:IsA("TextLabel") and (not oldestOrder or ch.LayoutOrder < oldestOrder) then
                    oldest, oldestOrder = ch, ch.LayoutOrder
                end
            end
            if oldest then
                oldest:Destroy()
                count -= 1
            end
        end
        if atBottom then
            task.defer(function()
                logs.CanvasPosition = Vector2.new(0, math.max(0, logs.AbsoluteCanvasSize.Y - logs.AbsoluteSize.Y))
            end)
        end
    end

    function Term.Clear()
        for _, ch in ipairs(logs:GetChildren()) do
            if ch:IsA("TextLabel") then ch:Destroy() end
        end
        count = 0
    end

    -- เขียนหลายบรรทัดลงหน้า EGGS / UNITS (ใช้ label ซ้ำ ไม่กระพริบ)
    function Term.SetLines(pageName, lines)
        local page = pages[pageName]
        if not page then return end
        local pool = {}
        for _, ch in ipairs(page:GetChildren()) do
            if ch:IsA("TextLabel") then pool[ch.LayoutOrder] = ch end
        end
        for i, text in ipairs(lines) do
            local lbl = pool[i]
            if not lbl then
                lbl = new("TextLabel", {
                    Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, Font = FONT, TextSize = 13, RichText = true,
                    TextWrapped = false, TextXAlignment = Enum.TextXAlignment.Left,
                    TextColor3 = C.text, LayoutOrder = i,
                }, page)
            end
            lbl.Text = text
            pool[i] = nil
        end
        for _, lbl in pairs(pool) do lbl:Destroy() end
    end

