-- ส่ง print ทั้งหมดในสคริปต์นี้ไปที่หน้าต่าง Terminal (และ console ด้วย)
local rawprint = print
local function print(...)
    local n = select("#", ...)
    local parts = {}
    for i = 1, n do parts[i] = tostring((select(i, ...))) end
    local s = table.concat(parts, " ")
    rawprint(s)
    Term.Print(s)
end

