local CFG = {
    AUTO_START     = true,   -- true = กด Wild + เลือกตัวให้เอง / false = เข้าโซนเองแล้วค่อยรัน
    PICK           = 1,      -- เลือก Creature ลำดับที่เท่าไหร่ (1 = ตัวดีสุดตามเกม)

    AUTO_ATTACK    = true,   -- ตีสัตว์อัตโนมัติ
    KILL_IN_ORDER  = true,   -- true = ตีไล่ e1, e2, ... จนถึงตัวที่ผูกกับไข่ / false = ไปตีตัวเป้าหมายเลย
    ATTACK_DELAY   = 0.25,   -- วินาทีระหว่างการตีแต่ละครั้ง
    ATTACK_RANGE   = 12,     -- ระยะที่ถือว่าใกล้พอ (studs)
    STUCK_RANGE    = 40,     -- ถ้าเดินต่อไม่ได้แล้ว (ชนตัวสัตว์) แต่อยู่ในระยะนี้ → ตีเลย
    DEBUG_ATTACK   = true,   -- พิมพ์ผลการตี + ระยะ (ไว้หาสาเหตุถ้าไม่โดน)

    TELEPORT       = false,  -- true = วาร์ปไปหาเป้าหมาย / false = เดินไป (ช้ากว่าแต่ปลอดภัยกว่า)

    AUTO_CLAIM     = true,   -- เก็บไข่เป้าหมายอัตโนมัติ
    RETURN_AFTER   = true,   -- ค่า returning ตอนเก็บไข่ (เกมส่ง true)
    MAX_EGG_TIER   = nil,    -- จำกัด tier ไข่สูงสุดที่จะไปเอา เช่น 8 (nil = ไม่จำกัด)
    TARGET_EGG     = nil,    -- บังคับเลือกไข่ เช่น "egg4" (nil = เลือกดีสุดอัตโนมัติ)

    MAX_RUNTIME    = 600,    -- หยุดเองถ้าเกินกี่วินาที กันค้าง
}

