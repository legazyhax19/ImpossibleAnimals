        statusText.Text = rich
    end
    function Term.SetStatusColor(col)
        status.BackgroundColor3 = col
    end

    -- คำสั่ง
    local history, hIndex = {}, 0
    box.FocusLost:Connect(function(enter)
        if not enter then return end
        local cmd = box.Text
        box.Text = ""
        if cmd:match("^%s*$") then return end
        table.insert(history, cmd)
        hIndex = #history + 1
        Term.Print('<font color="#3b8eea">$</font> ' .. esc(cmd), C.text, true)
        if Term.OnCommand then
            local ok, err = pcall(Term.OnCommand, cmd)
            if not ok then Term.Print("error: " .. tostring(err), C.red) end
        end
        task.defer(function() box:CaptureFocus() end)
    end)
    UserInputService.InputBegan:Connect(function(input)
        if not box:IsFocused() or #history == 0 then return end
        if input.KeyCode == Enum.KeyCode.Up then
            hIndex = math.max(1, hIndex - 1)
            box.Text = history[hIndex] or ""
            box.CursorPosition = #box.Text + 1
        elseif input.KeyCode == Enum.KeyCode.Down then
            hIndex = math.min(#history + 1, hIndex + 1)
            box.Text = history[hIndex] or ""
            box.CursorPosition = #box.Text + 1
        end
    end)

