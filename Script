local function resetZone()
    table.clear(W.Units)
    table.clear(W.Dead)
    table.clear(W.Eggs)
    table.clear(W.Claimed)
    table.clear(W.Chests)
    table.clear(W.ChestDone)
    table.clear(W.candidates)
    W.runId, W.runIdGuess = nil, false
    W.seq, W.attackCount, W.clickTries, W.scanCount = 0, 0, 0, 0
    W.curTarget, W.curEgg, W.claimGoal, W.chestGoal = nil, nil, nil, nil
end

local function markDead(id)
    W.Dead[id] = true
    W.Units[id] = nil
end

-- หน้าเลือกตัวละครเปิดอยู่ = ยังไม่ได้อยู่ในโซน
local function pickerOpen()
    local ok, vis = pcall(function()
        local root = player.PlayerGui.ImpossibleAnimals.Root
        local wp = root:FindFirstChild("WildPicker")
        if not wp then return false end
        local popup = wp:FindFirstChild("Popup")
        local v = wp.Visible
        if popup and popup:IsA("GuiObject") then v = v and popup.Visible end
        return v
    end)
    return ok and vis == true
end

local function leaveZone(reason)
    if not W.InWild then return end
    W.InWild = false
    W.readySent = false
    W.leftAt = os.clock()
    resetZone() -- ล้างเป้าหมายเก่าทิ้ง กันวาร์ปไปหาของค้าง
    log(reason)
end

table.insert(W.conns, Changed.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end

    if data.reset then resetZone() end
    -- ข้อมูลเริ่มรอบ (reset/eggs) = เข้าโซนแล้ว · ข้อมูลสัตว์อย่างเดียวนับเฉพาะเมื่อออกมานานแล้ว (กันข้อมูลค้างหลังตาย)
    -- นับว่าอยู่ในโซนเฉพาะหลังกดเลือกตัว (Ready) แล้ว และหน้าเลือกตัวปิดแล้ว
    if not W.InWild and not W.entering and W.readySent and not pickerOpen()
        and (data.reset or data.eggs or data.units) then
        W.InWild = true
    end
    if not W.runId and (W.scanCount or 0) < 10 then
        W.scanCount = (W.scanCount or 0) + 1
        scanUUIDs(data, "WildChanged")
    end

    if type(data.units) == "table" then
        for id, info in pairs(data.units) do
            if info == false then
                markDead(id)
            elseif type(info) == "table" then
                local u = W.Units[id] or {}
                for k, v in pairs(info) do u[k] = v end
                W.Units[id] = u
                if u.health and u.health <= 0 then markDead(id) end
            end
        end
    end
    if type(data.removed) == "table" then
        for _, id in pairs(data.removed) do markDead(id) end
    end

    if type(data.chests) == "table" then
        for key, ch in pairs(data.chests) do
            if type(ch) == "table" then
                local id = ch.id or key
                local c = W.Chests[id] or {}
                for k, v in pairs(ch) do c[k] = v end
                c.id = id
                W.Chests[id] = c
                if c.claimed or c.collected or c.opened then W.ChestDone[id] = true end
            elseif ch == false and type(key) == "string" then
                W.ChestDone[key] = true
            end
        end
    end

    if type(data.eggs) == "table" then
        for _, entry in pairs(data.eggs) do
            if type(entry) == "table" and entry.id then
                local e = W.Eggs[entry.id] or {}
                e.slot = entry.id
                e.tier = entry.tier or e.tier
                e.enemyId = entry.enemyId or e.enemyId
                e.position = entry.position or e.position
                if type(entry.egg) == "table" then
                    for k, v in pairs(entry.egg) do e[k] = v end
                end
                W.Eggs[entry.id] = e
            end
        end
    end

    if type(data.egg) == "table" and data.eggId then
        W.Claimed[data.eggId] = true
        log(string.format("ได้ไข่ %s%s %s ดาว", tostring(data.egg.kind),
            data.egg.shiny and (" " .. tostring(data.egg.shiny)) or "", tostring(data.egg.hatchStars)))
        if W.claimReturning then
            W.claimReturning = false
            leaveZone("กลับฐาน")
        end
    end
end))

