local function renderEggs()
    local list = {}
    for _, e in pairs(W.Eggs) do table.insert(list, e) end
    table.sort(list, function(a, b) return (a.tier or 0) < (b.tier or 0) end)
    local items = {}
    if #list == 0 then
        table.insert(items, { Text = '<font color="#5f5f5f">ยังไม่มีข้อมูลไข่ — เข้าโซน Wild ก่อน</font>' })
    end
    for _, e in ipairs(list) do
        local tag
        if W.Claimed[e.slot] then tag = '<font color="#23d18b">เก็บแล้ว</font>'
        elseif not eggInZone(e) then tag = '<font color="#5f5f5f">เกินโซน</font>'
        elseif eggPasses(e) then tag = '<font color="#23d18b">ผ่าน</font>'
        else tag = '<font color="#f14c4c">ไม่ผ่าน</font>' end
        local shiny = e.shiny and tostring(e.shiny):lower()
        table.insert(items, { Text = string.format(
            '<font color="#969696">Zone %s</font> <font color="%s">%s</font> <font color="%s">%s</font> <font color="#e5c07b">%s ดาว</font>   %s',
            esc(pad(e.tier, 3)),
            KIND_COLOR[tostring(e.kind)] or "#cccccc", esc(pad(e.kind, 10)),
            shiny and (SHINY_COLOR[shiny] or "#e5c07b") or "#5f5f5f", esc(pad(shiny or "", 11)),
            esc(pad(e.hatchStars, 3)), tag) })
    end
    eggListUI:SetItems(items)
end
