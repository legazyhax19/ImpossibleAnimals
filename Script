local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local function autoClick()
    local cam = workspace.CurrentCamera
    local size = cam and cam.ViewportSize or Vector2.new(800, 600)
    local x, y = math.floor(size.X / 2), math.floor(size.Y * 0.55)
    if VIM and pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end) then return true end
    if mouse1click and pcall(mouse1click) then return true end
    return false
end

local function attack(targetId, targetPos)
    local root = getRoot()
    if not root or not W.runId then return false end
    local dir = flat(targetPos) - flat(root.Position)
    dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 0, -1)
    W.seq += 1
    local ok, res = pcall(function()
        return Request:InvokeServer("Attack", { id = W.runId, direction = dir, sequence = W.seq, targetId = targetId })
    end)
    W.attackCount += 1
    if not ok then
        log("Attack error:", res)
    elseif CFG.DEBUG_ATTACK and (W.attackCount <= 3 or W.attackCount % 20 == 0) then
        local u = W.Units[targetId]
        local r = res
        if type(res) == "table" then
            local p = {}
            for k, v in pairs(res) do table.insert(p, tostring(k) .. "=" .. tostring(v)) end
            r = "{" .. table.concat(p, ", ") .. "}"
        end
        log(string.format("ตีครั้งที่ %d → %s  ระยะ %.0f  HP %s  ผล=%s", W.attackCount, targetId,
            distTo(targetPos), tostring(u and math.floor(u.health or 0) or "?"), tostring(r)))
    end
    return ok
end

local function approach(pos, range)
    local root, hum = getRoot()
    if not root or typeof(pos) ~= "Vector3" then return false end
    if distTo(pos) <= range then return true end
    if CFG.TELEPORT then
        local from, to = flat(root.Position), flat(pos)
        local back = from - to
        back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)
        local stand = to + back * math.max(range - 3, 2)
        local y = root.Position.Y
        W.lastTeleport = os.clock()
        root.CFrame = CFrame.new(Vector3.new(stand.X, y, stand.Z), Vector3.new(to.X, y, to.Z))
    elseif hum then
        hum:MoveTo(Vector3.new(pos.X, root.Position.Y, pos.Z))
    end
    return distTo(pos) <= range
end

local function claimEgg(slot)
    W.claimReturning = CFG.RETURN_AFTER
    local ok, res = pcall(function()
        return Request:InvokeServer("ClaimEgg", { id = W.runId or guid(), returning = CFG.RETURN_AFTER, eggId = slot })
    end)
    if not ok then log("ClaimEgg error:", res) end
    return ok
end

local function droppedEggs()
    local out = {}
    local ial = workspace:FindFirstChild("ImpossibleAnimalsLocal")
    local vis = ial and ial:FindFirstChild("WildVisuals")
    local sw = vis and vis:FindFirstChild("StreamedWilderness")
    local folder = sw and sw:FindFirstChild("WildEggs")
    if not folder then return out end
    for _, m in ipairs(folder:GetChildren()) do
        if m:GetAttribute("OwnerUserId") == player.UserId then
            local enemyId = m:GetAttribute("EnemyId")
            for _, e in pairs(W.Eggs) do
                if e.enemyId == enemyId and not W.Claimed[e.slot] then
                    table.insert(out, { egg = e, model = m })
                    break
                end
            end
        end
    end
    return out
end

local function enterWild()
    if W.entering then return false end
    W.entering = true
    local function done(v) W.entering = false return v end

    log("กด Wild...")
    resetZone()
    local ok, res = pcall(function() return Request:InvokeServer("Create", { teleport = true }) end)
    if not ok then log("Create error:", res) return done(false) end
    scanUUIDs(res, "Create")

    local creatures
    pcall(function()
        creatures = player:WaitForChild("PlayerGui"):WaitForChild("ImpossibleAnimals", 10):WaitForChild("Root", 10)
            :WaitForChild("WildPicker", 10):WaitForChild("Popup", 10):WaitForChild("Creatures", 10)
    end)
    if not creatures then log("ไม่เจอหน้าเลือกตัวละคร") return done(false) end

    local card
    for _ = 1, 40 do
        card = creatures:FindFirstChild("Creature" .. CFG.PICK)
        if card and card:GetAttribute("CreatureId") then break end
        task.wait(0.25)
    end
    if not card or not card:GetAttribute("CreatureId") then
        log("ไม่เจอ Creature" .. CFG.PICK)
        return done(false)
    end
    task.wait(0.5)
    for _, c in ipairs(creatures:GetChildren()) do
        local cid = c:GetAttribute("CreatureId")
        if cid then W.creatureIds[cid] = true end
    end
    local nameLbl = card:FindFirstChild("Content") and card.Content:FindFirstChild("Title")
        and card.Content.Title:FindFirstChild("CreatureName")
    log("เลือก Creature" .. CFG.PICK .. " " .. (nameLbl and nameLbl.Text or ""))

    local ok2, res2 = pcall(function()
        return Request:InvokeServer("Ready", { card:GetAttribute("CreatureId") })
    end)
    if not ok2 then log("Ready error:", res2) return done(false) end
    scanUUIDs(res2, "Ready")

    for _ = 1, 40 do
        if W.InWild then break end
        task.wait(0.25)
    end
    return done(W.InWild)
end

-- หา id รอบ: ลองค่าที่เจอในข้อมูลก่อน → ไม่มีก็คลิกจอให้เกมตีเอง
local function ensureRunId(target)
    if W.runId then return true end
    local c = table.remove(W.candidates, 1)
    if c then
        W.runId, W.runIdGuess, W.guessHp, W.guessAttacks = c.id, true, nil, 0
        return true
    end
    if CFG.AUTO_GET_ID then
        W.clickTries = (W.clickTries or 0) + 1
        if W.clickTries <= 10 then
            if W.clickTries == 1 then log("ยังไม่รู้ id ของรอบ — คลิกจอให้เกมตีหนึ่งที") end
            autoClick()
            for _ = 1, 10 do
                if W.runId then return true end
                task.wait(0.1)
            end
            return false
        end
    end
    if os.clock() - (W.lastAskLog or 0) > 5 then
        W.lastAskLog = os.clock()
        log("ยังไม่รู้ id ของรอบ — กดตีเองหนึ่งครั้ง (ตีลมก็ได้)")
    end
    return false
end

